<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dashboard" model="ir.module.category">
        <field name="name">Dashboards</field>
        <field name="sequence">25</field>
    </record>
    <record id="privilege_dashboard" model="res.groups.privilege">
        <field name="name">Dashboards</field>
        <field name="category_id" ref="module_category_dashboard"/>
    </record>
    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Responsable Dashboards</field>
        <field name="privilege_id" ref="privilege_dashboard"/>
        <field name="comment">Voit et gère tous les tableaux de bord.</field>
    </record>

    <record id="rule_dashboard_own_or_shared" model="ir.rule">
        <field name="name">Dashboard : propriétaire ou partagé (lecture)</field>
        <field name="model_id" ref="model_oski_dashboard"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_dashboard_own_write" model="ir.rule">
        <field name="name">Dashboard : écriture propriétaire</field>
        <field name="model_id" ref="model_oski_dashboard"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_dashboard_manager_all" model="ir.rule">
        <field name="name">Dashboard : manager voit tout</field>
        <field name="model_id" ref="model_oski_dashboard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
    </record>
    <record id="rule_dashboard_widget_follow" model="ir.rule">
        <field name="name">Widget : suit le dashboard (lecture)</field>
        <field name="model_id" ref="model_oski_dashboard_widget"/>
        <field name="domain_force">['|', ('dashboard_id.user_id', '=', user.id), ('dashboard_id.group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_dashboard_widget_own_write" model="ir.rule">
        <field name="name">Widget : écriture propriétaire dashboard</field>
        <field name="model_id" ref="model_oski_dashboard_widget"/>
        <field name="domain_force">[('dashboard_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_dashboard_widget_manager" model="ir.rule">
        <field name="name">Widget : manager voit tout</field>
        <field name="model_id" ref="model_oski_dashboard_widget"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
    </record>
</odoo>
