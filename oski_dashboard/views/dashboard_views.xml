<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oski_dashboard_list" model="ir.ui.view">
        <field name="name">oski.dashboard.list</field>
        <field name="model">oski.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="group_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="view_oski_dashboard_form" model="ir.ui.view">
        <field name="name">oski.dashboard.form</field>
        <field name="model">oski.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="refresh_interval"/>
                            <field name="company_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="widgets" string="Widgets">
                            <field name="widget_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="widget_type"/>
                                    <field name="model_id"/>
                                    <field name="period"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_oski_dashboard_config" model="ir.actions.act_window">
        <field name="name">Configuration des dashboards</field>
        <field name="res_model">oski.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_oski_dashboard_config" name="Configuration"
              parent="menu_oski_dashboard_root" action="action_oski_dashboard_config"
              groups="oski_dashboard.group_dashboard_manager" sequence="90"/>
</odoo>
