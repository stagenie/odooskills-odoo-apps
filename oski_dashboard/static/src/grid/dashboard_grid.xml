<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="oski_dashboard.DashboardGrid">
    <div class="o_oski_grid" t-ref="this.gridRef" t-att-class="{ o_oski_grid_edit: this.props.editMode }">
        <div t-foreach="this.props.widgets" t-as="widget" t-key="widget.id"
             class="o_oski_grid_cell" t-att-style="this.cellStyle(widget)"
             t-att-data-widget-id="widget.id">
            <WidgetShell widget="widget" dashboard="this.props.dashboard"
                         editMode="this.props.editMode" globalFilters="this.props.globalFilters"
                         reloadStamp="this.props.reloadStamp"
                         onEdit="this.props.onEdit" onRemove="this.props.onRemove"/>
            <div t-if="this.props.editMode" class="o_oski_resize_handle"/>
        </div>
    </div>
</t>
</templates>
