<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="oski_dashboard.WidgetShell">
    <div class="o_oski_widget card h-100">
        <div class="card-header d-flex align-items-center py-1 px-2">
            <span class="fw-bold text-truncate flex-grow-1" t-out="this.props.widget.name"/>
            <t t-if="this.props.editMode">
                <button class="btn btn-sm btn-link o_oski_widget_edit" title="Modifier"
                        t-on-click="() => this.props.onEdit and this.props.onEdit(this.props.widget)">
                    <i class="oi" data-icon="edit"/>
                </button>
                <button class="btn btn-sm btn-link text-danger o_oski_widget_remove" title="Supprimer"
                        t-on-click="() => this.props.onRemove and this.props.onRemove(this.props.widget)">
                    <i class="oi" data-icon="delete"/>
                </button>
            </t>
        </div>
        <div class="card-body p-2 overflow-hidden">
            <div t-if="this.state.error" class="alert alert-warning mb-0 small" t-out="this.state.error"/>
            <t t-elif="this.state.payload and this.widgetComponent">
                <!-- onSegmentClick : méthode patchée par le pro (drill.js), passée
                     par une flèche pour garder le contexte du composant. -->
                <t t-component="this.widgetComponent" widget="this.props.widget" payload="this.state.payload"
                   onSegmentClick="(index) => this.onSegmentClick(index)"/>
            </t>
            <div t-else="" class="d-flex justify-content-center align-items-center h-100">
                <i class="oi oi-spin" data-icon="autorenew"/>
            </div>
        </div>
    </div>
</t>
</templates>
