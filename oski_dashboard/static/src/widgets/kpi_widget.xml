<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="oski_dashboard.KpiWidget">
    <div class="d-flex flex-column justify-content-center align-items-center h-100">
        <div class="display-5 fw-bold" t-att-class="this.thresholdClass" t-out="this.formattedTotal"/>
        <div t-if="this.props.payload.delta_pct !== null" t-att-class="this.deltaClass" class="small">
            <i class="oi" t-att-data-icon="this.props.payload.delta_pct >= 0 ? 'arrow_upward' : 'arrow_downward'"/>
            <t t-out="this.props.payload.delta_pct"/>% vs période préc.
        </div>
        <div t-if="this.props.payload.target" class="progress w-75 mt-1" style="height: 6px;">
            <div class="progress-bar" t-att-style="'width:' + this.targetProgress + '%'"/>
        </div>
    </div>
</t>
</templates>
