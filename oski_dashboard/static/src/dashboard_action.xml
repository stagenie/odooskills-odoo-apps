<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<!-- Odoo 20 (OWL 3) : tout membre du composant s'écrit `this.x` dans le gabarit
     (les variables de t-foreach restent nues) ; icônes Material (`oi` + data-icon),
     FontAwesome n'est plus chargé. -->
<t t-name="oski_dashboard.DashboardAction">
    <div class="o_oski_dashboard_action d-flex flex-column h-100">
        <div class="o_oski_toolbar d-flex align-items-center gap-2 p-2 border-bottom">
            <select class="form-select w-auto o_oski_dashboard_select"
                    t-on-change="this.onSelectChange">
                <option t-foreach="this.state.dashboards" t-as="dashboard" t-key="dashboard.id"
                        t-att-value="dashboard.id"
                        t-att-selected="dashboard.id === this.state.currentId"
                        t-out="dashboard.name"/>
            </select>
            <button class="btn btn-link p-1 o_oski_toggle_favorite" t-if="this.current"
                    t-att-title="this.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris'"
                    t-on-click="this.toggleFavorite">
                <i class="oi" data-icon="star" t-att-class="this.isFavorite ? 'oi-filled text-warning' : ''"/>
            </button>
            <button class="btn btn-secondary o_oski_new_dashboard" t-on-click="this.createDashboard">
                Nouveau
            </button>
            <div class="flex-grow-1"/>
            <button class="btn btn-outline-secondary o_oski_refresh" t-if="this.current"
                    title="Rafraîchir" t-on-click="this.refreshWidgets">
                <i class="oi" data-icon="refresh"/>
            </button>
            <button class="btn btn-outline-secondary o_oski_add_widget" t-if="this.state.editMode"
                    t-on-click="this.addWidget">
                <i class="oi me-1" data-icon="add"/>Widget
            </button>
            <button class="btn o_oski_toggle_edit" t-if="this.current"
                    t-att-class="this.state.editMode ? 'btn-primary' : 'btn-outline-primary'"
                    t-on-click="this.toggleEdit">
                <i class="oi me-1" data-icon="edit"/>Éditer
            </button>
        </div>
        <div class="o_oski_filters_bar d-flex align-items-center flex-wrap gap-2 p-2 border-bottom"
             t-if="this.state.globalFilters.length">
            <span t-foreach="this.state.globalFilters" t-as="gf" t-key="gf_index"
                  class="badge text-bg-info o_oski_filter_chip">
                <t t-out="gf.label"/>
                <i class="oi ms-1" data-icon="close" role="button"
                   t-on-click="() => this.removeFilter(gf_index)"/>
            </span>
        </div>
        <div class="flex-grow-1 overflow-auto p-2">
            <div t-if="!this.state.dashboards.length" class="o_oski_empty text-center text-muted mt-5">
                <p>Aucun tableau de bord.</p>
                <button class="btn btn-primary" t-on-click="this.createDashboard">Créer le premier</button>
            </div>
            <DashboardGrid t-if="this.current" dashboard="this.current" widgets="this.state.widgets"
                           layout="this.state.layout" editMode="this.state.editMode"
                           globalFilters="this.state.globalFilters"
                           reloadStamp="this.state.reloadStamp"
                           onEdit.bind="this.editWidget" onRemove.bind="this.removeWidget"
                           onLayoutChange.bind="this.onLayoutChange"/>
        </div>
    </div>
</t>
</templates>
