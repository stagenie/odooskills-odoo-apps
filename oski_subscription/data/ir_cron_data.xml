<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_subscription_invoice" model="ir.cron">
        <field name="name">Abonnements : générer les factures</field>
        <field name="model_id" ref="model_sale_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_invoices()</field>
        <field name="interval_number">1</field>
