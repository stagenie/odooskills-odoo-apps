<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_subscription_plan_list" model="ir.ui.view">
        <field name="name">sale.subscription.plan.list</field>
        <field name="model">sale.subscription.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="billing_interval"/>
                <field name="billing_unit"/>
                <field name="auto_post_invoice"/>
            </list>
        </field>
    </record>

    <record id="view_sale_subscription_plan_form" model="ir.ui.view">
        <field name="name">sale.subscription.plan.form</field>
        <field name="model">sale.subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="billing_interval"/>
                        <field name="billing_unit"/>
                        <field name="auto_post_invoice"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_subscription_plan" model="ir.actions.act_window">
        <field name="name">Plans d'abonnement</field>
        <field name="res_model">sale.subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
