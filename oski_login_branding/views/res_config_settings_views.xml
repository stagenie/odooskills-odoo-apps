<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_oski_login" model="ir.ui.view">
        <field name="name">res.config.settings.form.oski.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']" position="after">
                <div class="row mt16 o_settings_container" name="oski_login_branding">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label string="Couleur de fond du login" for="oski_login_bg_color"/>
                            <div class="text-muted">
                                Couleur d'arrière-plan de la page de connexion.
                            </div>
                            <div class="content-group">
                                <field name="oski_login_bg_color" widget="color"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label string="Couleur d'accent du login" for="oski_login_accent_color"/>
                            <div class="text-muted">
                                Couleur des boutons et liens de la page de connexion.
                            </div>
                            <div class="content-group">
                                <field name="oski_login_accent_color" widget="color"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
