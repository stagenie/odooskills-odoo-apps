<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_oski_login" model="ir.ui.view">
        <field name="name">res.config.settings.form.oski.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="Login Page Customization"
                       name="oski_login_branding">
                    <setting string="Background Color"
                             help="Background color of the login page.">
                        <field name="oski_login_bg_color" widget="color"/>
                    </setting>
                    <setting string="Accent Color"
                             help="Color of the login page buttons and links.">
                        <field name="oski_login_accent_color" widget="color"/>
                    </setting>
                    <setting string="Logo"
                             help="The logo is set on each company (Settings &gt; Companies).">
                        <button name="%(base.action_res_company_form)d" type="action"
                                string="Set the logo per company" class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
