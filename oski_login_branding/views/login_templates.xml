<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="oski_login_branding" inherit_id="web.login_layout"
              name="OdooSkills Login Branding">
        <xpath expr="//div[@class='container py-5']" position="before">
            <t t-set="oski_bg"
               t-value="request.env['ir.config_parameter'].sudo().get_param('oski_login.bg_color')"/>
            <t t-set="oski_accent"
               t-value="request.env['ir.config_parameter'].sudo().get_param('oski_login.accent_color')"/>
            <t t-set="oski_logo"
               t-value="request.env['res.company'].sudo().search([], limit=1).oski_login_logo"/>
            <style t-if="oski_bg or oski_accent">
                <t t-if="oski_bg">body { background-color: <t t-out="oski_bg"/> !important; }</t>
                <t t-if="oski_accent">.btn-primary { background-color: <t t-out="oski_accent"/> !important; border-color: <t t-out="oski_accent"/> !important; }
                a { color: <t t-out="oski_accent"/>; }</t>
            </style>
        </xpath>
        <xpath expr="//div[@class='text-center pb-3 border-bottom mb-4']/img" position="attributes">
            <attribute name="t-attf-src"/>
            <attribute name="t-att-src">('data:image;base64,%s' % oski_logo.decode()) if oski_logo else ('/web/binary/company_logo' + ('?dbname=' + db if db else ''))</attribute>
        </xpath>
    </template>
</odoo>
