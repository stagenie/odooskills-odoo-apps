<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="oski_login_branding" inherit_id="web.login_layout"
              name="OdooSkills Login Branding">
        <xpath expr="//div[hasclass('container', 'py-5')]" position="before">
            <t t-set="oski_bg"
               t-value="request.env['ir.config_parameter'].sudo().get_str('oski_login.bg_color')"/>
            <t t-set="oski_accent"
               t-value="request.env['ir.config_parameter'].sudo().get_str('oski_login.accent_color')"/>
            <t t-set="oski_logo"
               t-value="request.env['res.company'].sudo().search([], limit=1).oski_login_logo"/>
            <style t-if="oski_bg or oski_accent">
                <t t-if="oski_bg">body { background-color: <t t-out="oski_bg"/> !important; }</t>
                <t t-if="oski_accent">.btn-primary { background-color: <t t-out="oski_accent"/> !important; border-color: <t t-out="oski_accent"/> !important; }
                a { color: <t t-out="oski_accent"/>; }</t>
            </style>
        </xpath>
        <!-- 20.0 masque le bloc du logo quand la société garde le logo par défaut :
             le logo de connexion doit s'afficher malgré tout. -->
        <xpath expr="//div[hasclass('pb-3', 'border-bottom', 'mb-4')]" position="attributes">
            <attribute name="t-if">oski_logo or not res_company.uses_default_logo</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pb-3', 'border-bottom', 'mb-4')]/img" position="attributes">
            <attribute name="t-attf-src"/>
            <attribute name="t-att-src">('data:image;base64,%s' % oski_logo.to_base64()) if oski_logo else ('/web/binary/company_logo' + ('?dbname=' + db if db else ''))</attribute>
        </xpath>
    </template>
</odoo>
