<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_oski_login_logo" model="ir.ui.view">
        <field name="name">res.company.form.oski.login.logo</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='logo']" position="after">
                <field name="oski_login_logo" widget="image"
                       class="oe_avatar"
                       options="{'size': [0, 90]}"/>
            </xpath>
        </field>
    </record>
</odoo>
