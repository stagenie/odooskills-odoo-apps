<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="team_support_demo" model="helpdesk.team">
            <field name="name">Support Client</field>
            <field name="assignment_method">balanced</field>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
        <record id="team_it_demo" model="helpdesk.team">
            <field name="name">IT Interne</field>
            <field name="assignment_method">manual</field>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="tag_bug_demo" model="helpdesk.tag">
            <field name="name">Bug</field><field name="color">1</field>
        </record>
        <record id="tag_question_demo" model="helpdesk.tag">
            <field name="name">Question</field><field name="color">4</field>
        </record>
        <record id="tag_urgent_demo" model="helpdesk.tag">
            <field name="name">Urgent</field><field name="color">2</field>
        </record>

        <record id="ticket_1_demo" model="helpdesk.ticket">
            <field name="name">Impossible de se connecter au portail</field>
            <field name="team_id" ref="team_support_demo"/>
            <field name="stage_id" ref="stage_new"/>
            <field name="priority">2</field>
            <field name="tag_ids" eval="[(4, ref('tag_bug_demo'))]"/>
        </record>
        <record id="ticket_2_demo" model="helpdesk.ticket">
            <field name="name">Demande de facture en double</field>
            <field name="team_id" ref="team_support_demo"/>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="priority">1</field>
            <field name="tag_ids" eval="[(4, ref('tag_question_demo'))]"/>
        </record>
        <record id="ticket_3_demo" model="helpdesk.ticket">
            <field name="name">Écran bleu au démarrage</field>
            <field name="team_id" ref="team_it_demo"/>
            <field name="stage_id" ref="stage_new"/>
            <field name="priority">3</field>
            <field name="tag_ids" eval="[(4, ref('tag_urgent_demo')), (4, ref('tag_bug_demo'))]"/>
        </record>
        <record id="ticket_4_demo" model="helpdesk.ticket">
            <field name="name">Réinitialisation du mot de passe</field>
            <field name="team_id" ref="team_it_demo"/>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="priority">1</field>
        </record>
        <record id="ticket_5_demo" model="helpdesk.ticket">
            <field name="name">Question sur l'abonnement</field>
            <field name="team_id" ref="team_support_demo"/>
            <field name="stage_id" ref="stage_waiting"/>
            <field name="priority">0</field>
            <field name="tag_ids" eval="[(4, ref('tag_question_demo'))]"/>
        </record>
        <record id="ticket_6_demo" model="helpdesk.ticket">
            <field name="name">Mise à jour résolue</field>
            <field name="team_id" ref="team_it_demo"/>
            <field name="stage_id" ref="stage_done"/>
            <field name="priority">1</field>
        </record>
    </data>
</odoo>
