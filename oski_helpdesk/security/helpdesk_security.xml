<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_helpdesk" model="ir.module.category">
        <field name="name">Assistance</field>
        <field name="description">Gestion des tickets d'assistance.</field>
        <field name="sequence">85</field>
    </record>

    <record id="privilege_helpdesk" model="res.groups.privilege">
        <field name="name">Assistance</field>
        <field name="sequence">85</field>
        <field name="category_id" ref="module_category_helpdesk"/>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Assistance / Utilisateur</field>
        <field name="privilege_id" ref="privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Assistance / Responsable</field>
        <field name="privilege_id" ref="privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
        <!-- Comme les applis standard (project, sales_team) : OdooBot et
             l'administrateur sont responsables. En 20, un Many2many valide le
             domaine du champ même en superutilisateur : sans cela, les données
             d'un module dépendant qui lient ce groupe à un champ filtré sur les
             groupes de l'utilisateur (mail.canned.response.group_ids) échouent. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
