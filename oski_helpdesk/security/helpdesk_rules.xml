<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-société : règles globales (ET avec toute règle de groupe). -->
    <record id="rule_helpdesk_team_company" model="ir.rule">
        <field name="name">Équipe d'assistance : sociétés autorisées</field>
        <field name="model_id" ref="model_helpdesk_team"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_helpdesk_ticket_company" model="ir.rule">
        <field name="name">Ticket d'assistance : sociétés autorisées</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
