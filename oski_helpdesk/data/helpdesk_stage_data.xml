<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_new" model="helpdesk.stage">
            <field name="name">Nouveau</field>
            <field name="sequence">10</field>
        </record>
        <record id="stage_in_progress" model="helpdesk.stage">
            <field name="name">En cours</field>
            <field name="sequence">20</field>
        </record>
        <record id="stage_waiting" model="helpdesk.stage">
            <field name="name">En attente</field>
            <field name="sequence">30</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_done" model="helpdesk.stage">
            <field name="name">Résolu</field>
            <field name="sequence">40</field>
            <field name="fold">True</field>
            <field name="is_close">True</field>
        </record>
    </data>
</odoo>
