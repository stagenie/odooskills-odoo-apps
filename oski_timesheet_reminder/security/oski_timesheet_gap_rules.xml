<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Un retard de saisie est une donnée personnelle : chacun ne voit que
         les siens, le valideur des feuilles de temps voit tout le monde. -->
    <record id="rule_oski_timesheet_gap_own" model="ir.rule">
        <field name="name">Retards de saisie : les siens</field>
        <field name="model_id" ref="model_oski_timesheet_gap"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_oski_timesheet_gap_approver" model="ir.rule">
        <field name="name">Retards de saisie : tous (valideur)</field>
        <field name="model_id" ref="model_oski_timesheet_gap"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_timesheet.group_hr_timesheet_approver'))]"/>
    </record>

    <record id="rule_oski_timesheet_gap_company" model="ir.rule">
        <field name="name">Retards de saisie : société courante</field>
        <field name="model_id" ref="model_oski_timesheet_gap"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
