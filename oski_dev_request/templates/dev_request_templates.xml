<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="form_page" name="Development request">
        <t t-call="website.layout">
            <div class="oski-store">
                <div class="container my-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="oski-hero mb-4">
                                <h1 class="mb-2">Request a custom module</h1>
                                <p>Describe your need: our team reviews it and gets back to you.</p>
                            </div>

                            <t t-if="error">
                                <div class="alert alert-danger" role="alert"><t t-out="error"/></div>
                            </t>

                            <form action="/apps/demande-developpement/submit" method="post"
                                  enctype="multipart/form-data" class="card p-4 shadow-sm">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <!-- Honeypot field: invisible and out of tab order for a
                                     human, irresistible to a bot that fills in everything. -->
                                <div style="position:absolute;left:-9999px;top:-9999px;"
                                     aria-hidden="true">
                                    <label t-attf-for="#{honeypot_field}">Leave this empty</label>
                                    <input type="text" t-att-name="honeypot_field"
                                           t-att-id="honeypot_field" tabindex="-1"
                                           autocomplete="off" value=""/>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Name <span class="text-danger">*</span></label>
                                        <input type="text" name="requester_name" class="form-control"
                                               required="required" t-att-value="values.get('requester_name', '')"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Company</label>
                                        <input type="text" name="company_name" class="form-control"
                                               t-att-value="values.get('company_name', '')"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Email <span class="text-danger">*</span></label>
                                        <input type="email" name="email" class="form-control"
                                               required="required" t-att-value="values.get('email', '')"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Phone</label>
                                        <input type="text" name="phone" class="form-control"
                                               t-att-value="values.get('phone', '')"/>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Subject <span class="text-danger">*</span></label>
                                    <input type="text" name="subject" class="form-control"
                                           required="required" t-att-value="values.get('subject', '')"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description of the need <span class="text-danger">*</span></label>
                                    <textarea name="description" class="form-control" rows="6"
                                              required="required"><t t-out="values.get('description', '')"/></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Category</label>
                                        <select name="category_id" class="form-select">
                                            <option value="">— Choose —</option>
                                            <t t-foreach="categories" t-as="cat">
                                                <option t-att-value="cat.id"
                                                        t-att-selected="'selected' if values.get('category_id') == str(cat.id) else None">
                                                    <t t-out="cat.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Target Odoo version</label>
                                        <select name="odoo_version" class="form-select">
                                            <t t-foreach="version_options" t-as="vo">
                                                <option t-att-value="vo[0]"
                                                        t-att-selected="'selected' if values.get('odoo_version', default_version) == vo[0] else None">
                                                    <t t-out="vo[1]"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Budget <span class="text-danger">*</span></label>
                                        <select name="budget_range" class="form-select" required="required">
                                            <t t-foreach="budget_options" t-as="bo">
                                                <option t-att-value="bo[0]"
                                                        t-att-selected="'selected' if values.get('budget_range') == bo[0] else None">
                                                    <t t-out="bo[1]"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Delivery mode</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="delivery_mode"
                                               id="dm_store" value="store"
                                               t-att-checked="'checked' if values.get('delivery_mode', 'store') != 'exclusive' else None"/>
                                        <label class="form-check-label" for="dm_store">
                                            <strong>Published on the store</strong> — standard price.
                                            The module will be published on the OdooSkills store and reusable.
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="delivery_mode"
                                               id="dm_excl" value="exclusive"
                                               t-att-checked="'checked' if values.get('delivery_mode') == 'exclusive' else None"/>
                                        <label class="form-check-label" for="dm_excl">
                                            <strong>Exclusive to me</strong> — the module stays private,
                                            not published on the store. <span class="text-danger">Significantly higher price.</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Attachments</label>
                                    <input type="file" name="attachments" class="form-control" multiple="multiple"/>
                                    <small class="text-muted">
                                        Max 5 files, 10 MB each. Allowed types: <t t-out="allowed_ext"/>.
                                    </small>
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary btn-lg">Send the request</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="catalog_grid_request_card" inherit_id="oski_app_store.catalog_page"
              name="Request card at the end of the grid">
        <xpath expr="//t[@t-foreach='modules']" position="after">
            <div t-if="modules" class="col">
                <a href="/apps/demande-developpement" class="oski-card oski-card-request h-100">
                    <div class="oski-card-top">
                        <span class="oski-monogram" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                        </span>
                        <span class="oski-badge oski-badge-custom">Custom</span>
                    </div>
                    <h2 class="oski-card-title">Can't find it?</h2>
                    <p class="oski-card-summary">Describe your need in two minutes: we review it and reply by email.</p>
                    <div class="oski-card-foot">
                        <span class="oski-card-cta">Request a module
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        </span>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

    <template id="catalog_empty_request_button" inherit_id="oski_app_store.catalog_page"
              name="Request button in the empty state">
        <xpath expr="//a[hasclass('oski-empty-reset')]" position="before">
            <a t-attf-href="/apps/demande-developpement#{'?' + prefill_query if prefill_query else ''}"
               class="oski-empty-request">Request this module
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
        </xpath>
    </template>

    <template id="thanks_page" name="Request sent">
        <t t-call="website.layout">
            <div class="oski-store">
                <div class="container my-5 text-center">
                    <div class="oski-hero mb-4">
                        <h1 class="mb-2">Thank you!</h1>
                        <p>Your request <strong t-if="ref"><t t-out="ref"/></strong> has been recorded.</p>
                    </div>
                    <p class="lead">Our team is reviewing it and will get back to you by email.</p>
                    <a href="/apps" class="btn btn-primary mt-3">Back to catalog</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
