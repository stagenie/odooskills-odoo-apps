<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_oski_dev_request" model="ir.sequence">
        <field name="name">Demande de développement</field>
        <field name="code">oski.dev.request</field>
        <field name="prefix">DR</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Email de notification interne des nouvelles demandes -->
    <record id="param_notify_email" model="ir.config_parameter">
        <field name="key">oski_dev_request.notify_email</field>
        <field name="value">info@odooskills.com</field>
    </record>
</odoo>
