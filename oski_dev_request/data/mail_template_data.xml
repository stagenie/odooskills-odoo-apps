<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Acknowledgement to the requester -->
    <record id="mail_template_dev_request_ack" model="mail.template">
        <field name="name">Dev request: acknowledgement</field>
        <field name="model_id" ref="model_oski_dev_request"/>
        <field name="subject">Your development request {{ object.name }}</field>
        <field name="email_from">{{ (object.env.company.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;color:#21112E;">
                <p>Hello <t t-out="object.requester_name or ''"/>,</p>
                <p>We have received your development request
                    <strong t-out="object.name or ''"/>: "<t t-out="object.subject or ''"/>".</p>
                <p>Our team is reviewing it and will get back to you shortly.</p>
                <p t-if="object.delivery_mode == 'exclusive'">
                    You have chosen <strong>exclusive</strong> delivery: the module will not be
                    published on the store and the price will be significantly higher than a
                    published app.
                </p>
                <p t-else="">
                    The developed module will be published on the OdooSkills store (standard price).
                </p>
                <p>— The OdooSkills team</p>
            </div>
        </field>
    </record>

    <!-- Internal notification -->
    <record id="mail_template_dev_request_notify" model="mail.template">
        <field name="name">Dev request: internal notification</field>
        <field name="model_id" ref="model_oski_dev_request"/>
        <field name="subject">New dev request {{ object.name }} — {{ object.subject }}</field>
        <field name="email_from">{{ (object.env.company.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.env['ir.config_parameter'].sudo().get_param('oski_dev_request.notify_email') }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;">
                <p>New request <strong t-out="object.name or ''"/>.</p>
                <ul>
                    <li>Requester: <t t-out="object.requester_name or ''"/>
                        (<t t-out="object.company_name or '—'"/>)</li>
                    <li>Email: <t t-out="object.email or ''"/></li>
                    <li>Subject: <t t-out="object.subject or ''"/></li>
                    <li>Category: <t t-out="object.category_id.name or '—'"/></li>
                    <li>Budget: <t t-out="object.budget_range or '—'"/></li>
                    <li>Mode: <t t-out="object.delivery_mode or ''"/></li>
                    <li>Version: <t t-out="object.odoo_version or '—'"/></li>
                </ul>
            </div>
        </field>
    </record>
</odoo>
