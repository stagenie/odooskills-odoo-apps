#. module: oski_dev_request
#: model:mail.template,body_html:oski_dev_request.mail_template_dev_request_notify
msgid ""
"<div style=\"font-family:Arial,sans-serif;\">\n"
"                <p>New request <strong t-out=\"object.name or ''\"/>.</p>\n"
"                <ul>\n"
"                    <li>Requester: <t t-out=\"object.requester_name or ''\"/>\n"
"                        (<t t-out=\"object.company_name or '—'\"/>)</li>\n"
"                    <li>Email: <t t-out=\"object.email or ''\"/></li>\n"
"                    <li>Subject: <t t-out=\"object.subject or ''\"/></li>\n"
"                    <li>Category: <t t-out=\"object.category_id.name or '—'\"/></li>\n"
"                    <li>Budget: <t t-out=\"object.budget_range or '—'\"/></li>\n"
"                    <li>Mode: <t t-out=\"object.delivery_mode or ''\"/></li>\n"
"                    <li>Version: <t t-out=\"object.odoo_version or '—'\"/></li>\n"
"                </ul>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family:Arial,sans-serif;\">\n"
"                <p>Nouvelle demande <strong t-out=\"object.name or ''\"/>.</p>\n"
"                <ul>\n"
"                    <li>Demandeur : <t t-out=\"object.requester_name or ''\"/>\n"
"                        (<t t-out=\"object.company_name or '—'\"/>)</li>\n"
"                    <li>Email : <t t-out=\"object.email or ''\"/></li>\n"
"                    <li>Objet : <t t-out=\"object.subject or ''\"/></li>\n"
"                    <li>Catégorie : <t t-out=\"object.category_id.name or '—'\"/></li>\n"
"                    <li>Budget : <t t-out=\"object.budget_range or '—'\"/></li>\n"
"                    <li>Mode : <t t-out=\"object.delivery_mode or ''\"/></li>\n"
"                    <li>Version : <t t-out=\"object.odoo_version or '—'\"/></li>\n"
"                </ul>\n"
"            </div>\n"
"        "

#. module: oski_dev_request
#: model:mail.template,body_html:oski_dev_request.mail_template_dev_request_ack
msgid ""
"<div style=\"font-family:Arial,sans-serif;color:#21112E;\">\n"
"                <p>Hello <t t-out=\"object.requester_name or ''\"/>,</p>\n"
"                <p>We have received your development request\n"
"                    <strong t-out=\"object.name or ''\"/>: \"<t t-out=\"object.subject or ''\"/>\".</p>\n"
"                <p>Our team is reviewing it and will get back to you shortly.</p>\n"
"                <p t-if=\"object.delivery_mode == 'exclusive'\">\n"
"                    You have chosen <strong>exclusive</strong> delivery: the module will not be\n"
"                    published on the store and the price will be significantly higher than a\n"
"                    published app.\n"
"                </p>\n"
"                <p t-else=\"\">\n"
"                    The developed module will be published on the OdooSkills store (standard price).\n"
"                </p>\n"
"                <p>— The OdooSkills team</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family:Arial,sans-serif;color:#21112E;\">\n"
"                <p>Bonjour <t t-out=\"object.requester_name or ''\"/>,</p>\n"
"                <p>Nous avons bien reçu votre demande de développement\n"
"                    <strong t-out=\"object.name or ''\"/> : « <t t-out=\"object.subject or ''\"/> ».</p>\n"
"                <p>Notre équipe l'analyse et reviendra vers vous rapidement.</p>\n"
"                <p t-if=\"object.delivery_mode == 'exclusive'\">\n"
"                    Vous avez choisi une livraison <strong>exclusive</strong> : le module ne sera pas\n"
"                    publié sur le store et le tarif sera nettement supérieur à une app publiée.\n"
"                </p>\n"
"                <p t-else=\"\">\n"
"                    Le module développé sera publié sur le store OdooSkills (tarif standard).\n"
"                </p>\n"
"                <p>— L'équipe OdooSkills</p>\n"
"            </div>\n"
"        "

