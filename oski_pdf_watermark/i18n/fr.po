msgstr "Taille"

#. module: oski_pdf_watermark
#. odoo-python
#: code:addons/oski_pdf_watermark/models/oski_report_watermark.py:0
msgid "The angle must be between -90 and 90 degrees. Received: %s."
msgstr "L'inclinaison se donne entre -90 et 90 degrés. Reçu : %s."

#. module: oski_pdf_watermark
#. odoo-python
#: code:addons/oski_pdf_watermark/models/oski_report_watermark.py:0
msgid "The color must be hexadecimal, for example #B02A37. Received: %s."
msgstr "La couleur se donne en hexadécimal, par exemple #B02A37. Reçu : %s."

#. module: oski_pdf_watermark
#. odoo-python
#: code:addons/oski_pdf_watermark/models/oski_report_watermark.py:0
msgid "The condition does not apply to model %(model)s: %(error)s"
msgstr "La condition ne s'applique pas au modèle %(model)s : %(error)s"

#. module: oski_pdf_watermark
#. odoo-python
#: code:addons/oski_pdf_watermark/models/oski_report_watermark.py:0
msgid "The condition is not a readable domain: %s"
msgstr "La condition n'est pas un domaine lisible : %s"

#. module: oski_pdf_watermark
#. odoo-python
#: code:addons/oski_pdf_watermark/models/oski_report_watermark.py:0
msgid "The condition must be a list, for example [('state', '=', 'draft')]."
msgstr "La condition doit être une liste, par exemple [('state', '=', 'draft')]."

#. module: oski_pdf_watermark
#. odoo-python
#: code:addons/oski_pdf_watermark/models/oski_report_watermark.py:0
msgid "The opacity must be between 0 and 1 — 0.12 for a discreet watermark. Received: %s."
msgstr "L'opacité se donne entre 0 et 1 — 0,12 pour un filigrane discret. Reçu : %s."

#. module: oski_pdf_watermark
#. odoo-python
#: code:addons/oski_pdf_watermark/models/oski_report_watermark.py:0
msgid "The size must be between 10 and 400 points. Received: %s."
msgstr "La taille se donne entre 10 et 400 points. Reçu : %s."

