<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oski_report_watermark_list" model="ir.ui.view">
        <field name="name">oski.report.watermark.list</field>
        <field name="model">oski.report.watermark</field>
        <field name="arch" type="xml">
            <list string="Watermarks">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="report_id"/>
                <field name="model_name"/>
                <field name="filter_domain" optional="show"/>
                <field name="text"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_oski_report_watermark_form" model="ir.ui.view">
        <field name="name">oski.report.watermark.form</field>
        <field name="model">oski.report.watermark</field>
        <field name="arch" type="xml">
            <form string="Watermark">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Unconfirmed quotation"/></h1>
                    </div>
                    <group>
                        <group string="When">
                            <field name="report_id" options="{'no_create': True}"/>
                            <field name="model_name"/>
                            <field name="filter_domain"
                                   placeholder="[('state', '=', 'draft')]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="What">
                            <field name="text" placeholder="DRAFT"/>
                            <field name="color" widget="color"/>
                            <field name="opacity"/>
                            <field name="angle"/>
                            <field name="font_size"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Several rules can target the same report: the first one in the list that accepts the document wins. When a print groups documents that call for different watermarks, none is applied — a fixed element repeats on every page and would wrongly mark the others.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oski_report_watermark_search" model="ir.ui.view">
        <field name="name">oski.report.watermark.search</field>
        <field name="model">oski.report.watermark</field>
        <field name="arch" type="xml">
            <search string="Watermarks">
                <field name="name"/>
                <field name="report_id"/>
                <field name="text"/>
                <filter name="inactive" string="Archived Watermarks" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_report" string="Report" domain="[]"
                            context="{'group_by': 'report_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oski_report_watermark" model="ir.actions.act_window">
        <field name="name">Report Watermarks</field>
        <field name="res_model">oski.report.watermark</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a first watermark</p>
            <p>
                A watermark marks the document itself: DRAFT while a quotation is unconfirmed, COPY on a reprint, CANCELLED on what no longer stands.
            </p>
        </field>
    </record>

    <menuitem id="menu_oski_report_watermark"
              name="Report Watermarks"
              parent="base.next_id_6"
              action="action_oski_report_watermark"
              sequence="35"/>

</odoo>
