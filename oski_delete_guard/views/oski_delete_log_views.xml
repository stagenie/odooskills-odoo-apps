<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oski_delete_log_list" model="ir.ui.view">
        <field name="name">oski.delete.log.list</field>
        <field name="model">oski.delete.log</field>
        <field name="arch" type="xml">
            <list string="Journal des suppressions" create="false" edit="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="model_label"/>
                <field name="model_name" optional="hide"/>
                <field name="res_id"/>
                <field name="res_name"/>
            </list>
        </field>
    </record>

    <record id="view_oski_delete_log_search" model="ir.ui.view">
        <field name="name">oski.delete.log.search</field>
        <field name="model">oski.delete.log</field>
        <field name="arch" type="xml">
            <search string="Journal des suppressions">
                <field name="res_name"/>
                <field name="model_name"/>
                <field name="user_id"/>
                <group>
                    <filter name="group_model" string="Modèle" domain="[]" context="{'group_by': 'model_name'}"/>
                    <filter name="group_user" string="Auteur" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Date" domain="[]" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oski_delete_log" model="ir.actions.act_window">
        <field name="name">Journal des suppressions</field>
        <field name="res_model">oski.delete.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_oski_delete_log"
              name="Journal des suppressions"
              parent="base.menu_custom"
              action="action_oski_delete_log"
              sequence="55"/>
</odoo>
