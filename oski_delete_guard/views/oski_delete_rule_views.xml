<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oski_delete_rule_list" model="ir.ui.view">
        <field name="name">oski.delete.rule.list</field>
        <field name="model">oski.delete.rule</field>
        <field name="arch" type="xml">
            <list string="Règles de suppression" decoration-danger="mode == 'block'">
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="mode"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_oski_delete_rule_form" model="ir.ui.view">
        <field name="name">oski.delete.rule.form</field>
        <field name="model">oski.delete.rule</field>
        <field name="arch" type="xml">
            <form string="Règle de suppression">
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="model_name"/>
                        <field name="mode"/>
                        <field name="group_ids" widget="many2many_tags"
                               invisible="mode != 'block'"/>
                        <field name="message" placeholder="Cette pièce ne se supprime pas : archivez-la."
                               invisible="mode != 'block'"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        Aucun groupe autorisé signifie : personne ne peut supprimer.
                        Les opérations système ne sont jamais bloquées.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oski_delete_rule" model="ir.actions.act_window">
        <field name="name">Règles de suppression</field>
        <field name="res_model">oski.delete.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oski_delete_rule"
              name="Règles de suppression"
              parent="base.menu_custom"
              action="action_oski_delete_rule"
              sequence="54"/>
</odoo>
