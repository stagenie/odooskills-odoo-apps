<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rental" model="ir.module.category">
        <field name="name">Location</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_rental_user" model="res.groups">
        <field name="name">Location / Utilisateur</field>
        <field name="category_id" ref="module_category_rental"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rental_manager" model="res.groups">
        <field name="name">Location / Responsable</field>
        <field name="category_id" ref="module_category_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_rental_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rental_asset_company" model="ir.rule">
        <field name="name">Ressource location : multi-société</field>
        <field name="model_id" ref="model_oski_rental_asset"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rental_order_company" model="ir.rule">
        <field name="name">Location : multi-société</field>
        <field name="model_id" ref="model_oski_rental_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rental_order_line_company" model="ir.rule">
        <field name="name">Ligne de location : multi-société</field>
        <field name="model_id" ref="model_oski_rental_order_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rental_unavailability_company" model="ir.rule">
        <field name="name">Indisponibilité : multi-société</field>
        <field name="model_id" ref="model_oski_rental_unavailability"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
