<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="oski_attachment_purge_view_list" model="ir.ui.view">
        <field name="name">oski.attachment.purge.list</field>
        <field name="model">oski.attachment.purge</field>
        <field name="arch" type="xml">
            <list string="Purges" create="false" edit="false">
                <field name="purged_on"/>
                <field name="user_id"/>
                <field name="attachment_count" sum="Total"/>
                <field name="freed_bytes" sum="Octets libérés"/>
                <field name="criteria"/>
            </list>
        </field>
    </record>

    <record id="oski_attachment_purge_view_form" model="ir.ui.view">
        <field name="name">oski.attachment.purge.form</field>
        <field name="model">oski.attachment.purge</field>
        <field name="arch" type="xml">
            <form string="Purge" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="purged_on"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="attachment_count"/>
                            <field name="freed_bytes"/>
                            <field name="criteria"/>
                        </group>
                    </group>
                    <group string="Pièces supprimées">
                        <field name="detail" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oski_attachment_purge_action" model="ir.actions.act_window">
        <field name="name">Purges de pièces jointes</field>
        <field name="res_model">oski.attachment.purge</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune purge</p>
            <p>Chaque purge laisse ici sa trace : qui, quand, combien, sur quels critères.</p>
        </field>
    </record>

    <menuitem id="oski_attachment_purge_menu"
              name="Purges de pièces jointes"
              parent="base.next_id_9"
              action="oski_attachment_purge_action"
              sequence="21"
              groups="base.group_system"/>
</odoo>
