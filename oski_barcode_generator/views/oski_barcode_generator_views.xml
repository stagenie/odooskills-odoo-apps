<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oski_barcode_generator_form" model="ir.ui.view">
        <field name="name">oski.barcode.generator.form</field>
        <field name="model">oski.barcode.generator</field>
        <field name="arch" type="xml">
            <form string="Generate Barcodes">
                <group>
                    <field name="prefix"/>
                    <field name="scope"/>
                    <field name="limit"/>
                    <field name="candidate_count"/>
                </group>
                <div class="text-muted">
                    Products that already have a barcode are never touched: overwriting a code would break the labels already printed and the scanners that read them.
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- La liste rendue après génération : ce qu'on vient d'attribuer doit se
         lire, code compris (la liste standard des variantes le cache). -->
    <record id="view_oski_barcode_served_list" model="ir.ui.view">
        <field name="name">product.product.list.oski.barcode.served</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Barcoded Products" create="false">
                <field name="default_code"/>
                <field name="name"/>
                <field name="product_template_variant_value_ids" widget="many2many_tags"/>
                <field name="barcode"/>
            </list>
        </field>
    </record>

    <record id="action_oski_barcode_generator" model="ir.actions.act_window">
        <field name="name">Generate Barcodes</field>
        <field name="res_model">oski.barcode.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- L'assistant est réservé aux administrateurs (droits d'accès) :
             le proposer aux autres ne mènerait qu'à une erreur d'accès. -->
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="context">{'default_scope': 'empty'}</field>
    </record>

    <record id="action_oski_barcode_generator_products" model="ir.actions.act_window">
        <field name="name">Generate Barcodes</field>
        <field name="res_model">oski.barcode.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- L'assistant est réservé aux administrateurs (droits d'accès) :
             le proposer aux autres ne mènerait qu'à une erreur d'accès. -->
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="context">{'default_scope': 'selected'}</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_oski_barcode_generator_variants" model="ir.actions.act_window">
        <field name="name">Generate Barcodes</field>
        <field name="res_model">oski.barcode.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- L'assistant est réservé aux administrateurs (droits d'accès) :
             le proposer aux autres ne mènerait qu'à une erreur d'accès. -->
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="context">{'default_scope': 'selected'}</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
