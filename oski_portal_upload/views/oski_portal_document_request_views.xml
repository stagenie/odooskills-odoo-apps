<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oski_portal_document_request_list" model="ir.ui.view">
        <field name="name">oski.portal.document.request.list</field>
        <field name="model">oski.portal.document.request</field>
        <field name="arch" type="xml">
            <list string="Requested Documents"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="state == 'pending' and deadline and deadline &lt; current_date">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="resource_ref" widget="reference"/>
                <field name="deadline"/>
                <field name="received_on" optional="hide"/>
                <field name="attachment_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'received'"
                       decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_oski_portal_document_request_form" model="ir.ui.view">
        <field name="name">oski.portal.document.request.form</field>
        <field name="model">oski.portal.document.request</field>
        <field name="arch" type="xml">
            <form string="Requested Document">
                <header>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'pending'"/>
                    <button name="action_reset" type="object" string="Reopen"
                            invisible="state != 'cancelled'"/>
                    <button name="action_open_record" type="object"
                            string="Open Record" class="btn-secondary"
                            invisible="not res_model"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Signed purchase order"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="resource_ref" widget="reference"/>
                            <field name="partner_id"/>
                            <field name="deadline"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="res_model" invisible="1"/>
                        </group>
                        <group>
                            <field name="attachment_id" invisible="state != 'received'"/>
                            <field name="received_on" invisible="state != 'received'"/>
                        </group>
                    </group>
                    <group string="Details shown to the customer">
                        <field name="note" nolabel="1" colspan="2"
                               placeholder="The signed and dated order, cover page included."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oski_portal_document_request_search" model="ir.ui.view">
        <field name="name">oski.portal.document.request.search</field>
        <field name="model">oski.portal.document.request</field>
        <field name="arch" type="xml">
            <search string="Requested Documents">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="pending" string="Pending Documents"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="received" string="Received Documents"
                        domain="[('state', '=', 'received')]"/>
                <separator/>
                <filter name="late" string="Late"
                        domain="[('state', '=', 'pending'), ('deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_state" string="Status" domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Customer" domain="[]"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_deadline" string="Deadline" domain="[]"
                            context="{'group_by': 'deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oski_portal_document_request" model="ir.actions.act_window">
        <field name="name">Requested Documents</field>
        <field name="res_model">oski.portal.document.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Request a first document</p>
            <p>
                The document appears on the portal page of the target record. The customer uploads it from there, and you find it attached to the record, announced in its chatter.
            </p>
        </field>
    </record>

    <menuitem id="menu_oski_portal_upload_root"
              name="Customer Documents"
              web_icon="oski_portal_upload,static/description/icon.png"
              sequence="95"/>

    <menuitem id="menu_oski_portal_document_request"
              name="Requested Documents"
              parent="menu_oski_portal_upload_root"
              action="action_oski_portal_document_request"
              sequence="10"/>

</odoo>
