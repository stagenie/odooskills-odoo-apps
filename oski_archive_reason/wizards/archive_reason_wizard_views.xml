<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oski_archive_reason_wizard_form" model="ir.ui.view">
        <field name="name">oski.archive.reason.wizard.form</field>
        <field name="model">oski.archive.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Motif d'archivage">
                <group>
                    <field name="reason" placeholder="Pourquoi archiver cet enregistrement ?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Archiver"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
