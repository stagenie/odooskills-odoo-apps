#. module: oski_app_store
#: model:mail.template,body_html:oski_app_store.mail_template_store_confirmation
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:14px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\">client</t>,</p>\n"
"    <p>\n"
"        Your order <strong t-out=\"object.name or ''\">S00001</strong> is confirmed.\n"
"        Your applications are available immediately.\n"
"    </p>\n"
"    <div style=\"margin:24px 0px;text-align:center;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/apps\" style=\"background-color:#21112E;padding:12px 24px;text-decoration:none;&#10;                  color:#FFFFFF;border-radius:4px;font-weight:600;display:inline-block;\">\n"
"            Download my applications\n"
"        </a>\n"
"    </div>\n"
"    <p>\n"
"        This page stays available: it offers the archive of every module,\n"
"        for every published Odoo version. You can come back to it any time\n"
"        from your customer area.\n"
"    </p>\n"
"    <p>\n"
"        Your invoice is attached to this message.\n"
"        A question about installing a module&nbsp;?\n"
"        Just reply to this e-mail.\n"
"    </p>\n"
"    <p style=\"color:#888888;font-size:12px;\">\n"
"        <t t-out=\"object.company_id.name or ''\">Odoo &amp; AI Skills LLC</t>\n"
"    </p>\n"
"</div>"
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:14px;\">\n"
"    <p>Bonjour <t t-out=\"object.partner_id.name or ''\">client</t>,</p>\n"
"    <p>\n"
"        Votre commande <strong t-out=\"object.name or ''\">S00001</strong> est confirmée.\n"
"        Vos applications sont disponibles immédiatement.\n"
"    </p>\n"
"    <div style=\"margin:24px 0px;text-align:center;\">\n"
"        <a t-attf-href=\"{{ object.get_base_url() }}/my/apps\" style=\"background-color:#21112E;padding:12px 24px;text-decoration:none;&#10;                  color:#FFFFFF;border-radius:4px;font-weight:600;display:inline-block;\">\n"
"            Télécharger mes applications\n"
"        </a>\n"
"    </div>\n"
"    <p>\n"
"        Cette page reste disponible : elle propose l'archive de chaque module,\n"
"        pour chaque version Odoo publiée. Vous pouvez y revenir à tout moment\n"
"        depuis votre espace client.\n"
"    </p>\n"
"    <p>\n"
"        Votre facture est jointe à ce message.\n"
"        Une question sur l'installation d'un module&nbsp;?\n"
"        Il suffit de répondre à cet e-mail.\n"
"    </p>\n"
"    <p style=\"color:#888888;font-size:12px;\">\n"
"        <t t-out=\"object.company_id.name or ''\">Odoo &amp; AI Skills LLC</t>\n"
"    </p>\n"
"</div>"

