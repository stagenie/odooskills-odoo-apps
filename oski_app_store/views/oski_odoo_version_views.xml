<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="oski_odoo_version_view_list" model="ir.ui.view">
        <field name="name">oski.odoo.version.view.list</field>
        <field name="model">oski.odoo.version</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence"/>
                <field name="name"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="oski_odoo_version_action" model="ir.actions.act_window">
        <field name="name">Versions Odoo</field>
        <field name="res_model">oski.odoo.version</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
