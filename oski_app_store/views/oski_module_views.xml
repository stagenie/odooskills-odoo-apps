<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="oski_module_view_list" model="ir.ui.view">
        <field name="name">oski.module.list</field>
        <field name="model">oski.module</field>
        <field name="arch" type="xml">
            <list string="Modules">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category_id"/>
                <field name="is_free"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price" widget="monetary" optional="show"/>
                <field name="download_count" optional="show"/>
                <field name="purchase_count" optional="show"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>

    <record id="oski_module_view_kanban" model="ir.ui.view">
        <field name="name">oski.module.kanban</field>
        <field name="model">oski.module</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="is_free"/>
                <field name="currency_id"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <field name="image_1920" widget="image"
                                   class="o_image_64_cover me-2 rounded" alt="Icon"/>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-truncate"><field name="name"/></strong>
                                    <span t-if="record.is_free.raw_value"
                                          class="badge text-bg-success ms-1">Free</span>
                                    <span t-else="" class="badge text-bg-primary ms-1">Premium</span>
                                </div>
                                <small class="text-muted d-block text-truncate">
                                    <field name="technical_name"/>
                                </small>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <small class="text-muted"><field name="category_id"/></small>
                                    <strong t-if="!record.is_free.raw_value" class="text-primary">
                                        <field name="price" widget="monetary"/>
                                    </strong>
                                </div>
                                <span t-if="!record.is_published.raw_value"
                                      class="badge text-bg-secondary mt-1">Unpublished</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="oski_module_view_form" model="ir.ui.view">
        <field name="name">oski.module.form</field>
        <field name="model">oski.module</field>
        <field name="arch" type="xml">
            <form string="Module">
                <header>
                    <field name="is_published" widget="boolean_toggle"
                           string="Publish on the store"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success"
                            invisible="not is_published"/>
                    <widget name="web_ribbon" title="Unpublished" bg_color="text-bg-secondary"
                            invisible="is_published"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Display name"/></h1>
                        <field name="technical_name" placeholder="oski_xxx"/>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="license"/>
                            <field name="is_free"/>
                        </group>
                        <group>
                            <field name="author"/>
                            <field name="maintainer"/>
                            <field name="product_tmpl_id"/>
                        </group>
                    </group>
                    <field name="summary" placeholder="Short summary"/>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description_html"/>
                        </page>
                        <page string="Versions" name="versions">
                            <field name="version_line_ids">
                                <list editable="bottom">
                                    <field name="odoo_version_id" required="1"/>
                                    <field name="module_version"/>
                                    <field name="attachment_id"/>
                                    <field name="released_date"/>
                                    <field name="changelog"/>
                                    <field name="download_count" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Screenshots" name="screenshots">
                            <field name="screenshot_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Dependencies" name="dependencies">
                            <field name="dependency_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oski_module_view_search" model="ir.ui.view">
        <field name="name">oski.module.search</field>
        <field name="model">oski.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <filter name="published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="free" string="Free" domain="[('is_free', '=', True)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="oski_module_action" model="ir.actions.act_window">
        <field name="name">Modules</field>
        <field name="res_model">oski.module</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
