<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compteurs triables des modules (stat_*) : une requête SQL par heure. -->
    <record id="ir_cron_oski_stats_refresh" model="ir.cron">
        <field name="name">OdooSkills Store: refresh module statistics</field>
        <field name="model_id" ref="model_oski_module"/>
        <field name="state">code</field>
        <field name="code">model._cron_stats_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Paniers anonymes abandonnés (souvent ouverts par des robots) : purge quotidienne. -->
    <record id="ir_cron_oski_purge_anonymous_carts" model="ir.cron">
        <field name="name">OdooSkills Store: delete abandoned anonymous carts</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_oski_purge_anonymous_carts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
