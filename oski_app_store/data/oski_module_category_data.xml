<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cat_sales" model="oski.module.category">
        <field name="name">Ventes &amp; CRM</field>
        <field name="sequence">10</field>
    </record>
    <record id="cat_accounting" model="oski.module.category">
        <field name="name">Comptabilité &amp; Finance</field>
        <field name="sequence">20</field>
    </record>
    <record id="cat_hr" model="oski.module.category">
        <field name="name">Ressources Humaines</field>
        <field name="sequence">30</field>
    </record>
    <record id="cat_website" model="oski.module.category">
        <field name="name">Site web &amp; eCommerce</field>
        <field name="sequence">40</field>
    </record>
    <!-- Les trois catégories ci-dessous ont été ajoutées après coup. Deux
         d'entre elles (Inventaire, Projet) existaient déjà en base, créées à la
         main et donc SANS xmlid : l'importeur ne pouvait pas les atteindre et
         entassait tout dans Productivité. Leur xmlid a été posé sur les
         enregistrements existants avant ce chargement, qui les met à jour au
         lieu d'en créer des doublons. -->
    <record id="cat_inventory" model="oski.module.category">
        <field name="name">Inventaire &amp; Logistique</field>
        <field name="sequence">25</field>
    </record>
    <record id="cat_manufacturing" model="oski.module.category">
        <field name="name">Fabrication &amp; Qualité</field>
        <field name="sequence">35</field>
    </record>
    <record id="cat_project" model="oski.module.category">
        <field name="name">Projet &amp; Services</field>
        <field name="sequence">45</field>
    </record>
    <!-- Les trois bacs ci-dessous ont été ouverts avant l'import des familles
         Patrimoine, Santé et Location. Sans eux, les 19 modules de patrimoine
         (catégorie manifeste « Operations », qu'aucune règle ne connaissait)
         seraient tombés dans Technique & Outils et les 14 modules de santé
         (« Services ») auraient porté Projet & Services à 30 fiches : la
         taxonomie tout juste rééquilibrée se serait redéséquilibrée. -->
    <record id="cat_assets" model="oski.module.category">
        <field name="name">Patrimoine &amp; Maintenance</field>
        <field name="sequence">38</field>
    </record>
    <record id="cat_health" model="oski.module.category">
        <field name="name">Santé</field>
        <field name="sequence">46</field>
    </record>
    <record id="cat_rental" model="oski.module.category">
        <field name="name">Location</field>
        <field name="sequence">47</field>
    </record>
    <!-- La famille inter-sociétés traverse stock, ventes et comptabilité :
         aucun bac fonctionnel ne la possède, et la disperser revenait à la
         rendre introuvable pour qui cherche du multi-sociétés. -->
    <record id="cat_multicompany" model="oski.module.category">
        <field name="name">Multi-sociétés</field>
        <field name="sequence">48</field>
    </record>
    <record id="cat_productivity" model="oski.module.category">
        <field name="name">Productivité</field>
        <field name="sequence">50</field>
    </record>
    <record id="cat_technical" model="oski.module.category">
        <field name="name">Technique &amp; Outils</field>
        <field name="sequence">60</field>
    </record>
</odoo>
