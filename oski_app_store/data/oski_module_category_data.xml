<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cat_sales" model="oski.module.category">
        <field name="name">Sales &amp; CRM</field>
        <field name="sequence">10</field>
    </record>
    <record id="cat_accounting" model="oski.module.category">
        <field name="name">Accounting &amp; Finance</field>
        <field name="sequence">20</field>
    </record>
    <record id="cat_hr" model="oski.module.category">
        <field name="name">Human Resources</field>
        <field name="sequence">30</field>
    </record>
    <record id="cat_website" model="oski.module.category">
        <field name="name">Website &amp; eCommerce</field>
        <field name="sequence">40</field>
    </record>
    <!-- The three categories below were added afterwards. Two of them
         (Inventory, Project) already existed in the database, created by
         hand and therefore WITHOUT an xmlid: the importer could not reach
         them and piled everything into Productivity. Their xmlid was set on
         the existing records before this load, which updates them instead
         of creating duplicates. -->
    <record id="cat_inventory" model="oski.module.category">
        <field name="name">Inventory &amp; Logistics</field>
        <field name="sequence">25</field>
    </record>
    <record id="cat_manufacturing" model="oski.module.category">
        <field name="name">Manufacturing &amp; Quality</field>
        <field name="sequence">35</field>
    </record>
    <record id="cat_project" model="oski.module.category">
        <field name="name">Project &amp; Services</field>
        <field name="sequence">45</field>
    </record>
    <!-- The three bins below were opened before importing the Assets,
         Health and Rental families. Without them, the 19 asset modules
         (manifest category "Operations", which no rule recognized) would
         have fallen into Technical & Tools, and the 14 health modules
         ("Services") would have pushed Project & Services to 30 listings:
         the taxonomy just rebalanced would have become unbalanced again. -->
    <record id="cat_assets" model="oski.module.category">
        <field name="name">Assets &amp; Maintenance</field>
        <field name="sequence">38</field>
    </record>
    <record id="cat_health" model="oski.module.category">
        <field name="name">Health</field>
        <field name="sequence">46</field>
    </record>
    <record id="cat_rental" model="oski.module.category">
        <field name="name">Rental</field>
        <field name="sequence">47</field>
    </record>
    <!-- The intercompany family spans stock, sales and accounting: no
         functional bin owns it, and scattering it across those would make
         it unfindable for anyone looking for multi-company modules. -->
    <record id="cat_multicompany" model="oski.module.category">
        <field name="name">Multi-Company</field>
        <field name="sequence">48</field>
    </record>
    <record id="cat_productivity" model="oski.module.category">
        <field name="name">Productivity</field>
        <field name="sequence">50</field>
    </record>
    <record id="cat_technical" model="oski.module.category">
        <field name="name">Technical &amp; Tools</field>
        <field name="sequence">60</field>
    </record>
</odoo>
