<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="module_page" name="Page module">
        <t t-call="website.layout">
            <div class="oski-store">
            <div class="container py-5">
                <a class="oski-back" t-att-href="back_url">&#8592; Retour au catalogue</a>
                <t t-set="has_shots" t-value="bool(screenshots)"/>
                <div class="row g-4 mb-4">
                    <!-- Carte fiche technique (haut gauche) -->
                    <div t-attf-class="#{'col-lg-5' if has_shots else 'col-12 oski-techcard-wide'}">
                        <div class="oski-techcard">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <t t-call="oski_app_store.module_icon"/>
                                <div>
                                    <h1 class="oski-module-title" t-out="module.name"/>
                                    <span t-if="module.is_free" class="oski-badge oski-badge-free">Gratuit</span>
                                    <span t-else="" class="oski-badge oski-badge-premium">Premium</span>
                                </div>
                            </div>
                            <p class="oski-module-summary" t-out="module.summary"/>
                            <table class="oski-techtable">
                                <tr><th>Nom technique</th><td><code t-out="module.technical_name"/></td></tr>
                                <tr><th>Licence</th><td t-out="dict(module._fields['license'].selection).get(module.license)"/></tr>
                                <tr><th>Auteur</th><td t-out="module.author"/></tr>
                            </table>
                            <div class="oski-version-select mb-3" aria-label="Version Odoo">
                                <t t-set="avail" t-value="module.available_versions()"/>
                                <t t-foreach="pill_versions" t-as="pv">
                                    <a t-attf-href="#{module.website_url}?v=#{pv}"
                                       t-att-title="'Odoo %s — pas encore sortie' % pv if pv in upcoming_versions else pv"
                                       t-attf-class="oski-vpill #{'on' if pv in avail else 'off'} #{'sel' if pv == version else ''} #{'soon' if pv in upcoming_versions else ''}"
                                       t-out="pv"/>
                                </t>
                            </div>
                            <div class="oski-chips mb-3" t-if="module.tag_ids">
                                <t t-foreach="module.tag_ids" t-as="tag">
                                    <a t-attf-href="/apps?tag=#{tag.id}" class="oski-chip" t-out="tag.name"/>
                                </t>
                            </div>
                            <!-- Dépendances catalogue : lien si la fiche cible est
                                 publiée, sinon nom simple (la page cible ferait 404). -->
                            <div class="oski-deps mb-3" t-if="module.dependency_ids">
                                <span class="oski-deps-label">Nécessite&#160;:</span>
                                <t t-foreach="module.dependency_ids" t-as="dep">
                                    <a t-if="dep.website_published" t-att-href="dep.website_url"
                                       class="oski-chip" t-out="dep.name"/>
                                    <span t-else="" class="oski-chip oski-chip-static" t-out="dep.name"/>
                                </t>
                            </div>
                            <t t-set="target" t-value="module.download_target(version)"/>
                            <t t-if="target and target.attachment_id">
                                <!-- Gratuit ou déjà payé : on télécharge. Sinon on achète,
                                     prix affiché sur le bouton. Un module payant sans produit
                                     lié n'est pas vendable : on le dit plutôt que d'offrir un
                                     bouton mort. -->
                                <a t-if="module.is_free or is_purchased"
                                   t-attf-href="/apps/download/#{target.id}"
                                   class="btn oski-btn-download w-100">
                                    &#x2B07; Télécharger (<t t-out="target.odoo_version"/>)
                                </a>
                                <t t-elif="is_sellable">
                                    <a t-att-href="buy_url"
                                       class="btn oski-btn-buy w-100">
                                        Acheter —
                                        <span t-field="module.price"
                                              t-options='{"widget": "monetary", "display_currency": module.currency_id}'/>
                                    </a>
                                </t>
                                <p t-else="" class="text-muted mb-0">
                                    Bientôt en vente.
                                </p>
                                <p t-if="is_purchased" class="oski-owned-note">
                                    Vous possédez ce module —
                                    <a href="/my/apps">toutes vos applications</a>.
                                </p>
                                <p t-if="target.odoo_version != version" class="oski-fallback-note">
                                    Indisponible en <t t-out="version"/> — dernière version proposée :
                                    <t t-out="target.odoo_version"/>.
                                </p>
                            </t>
                            <t t-else="">
                                <p class="text-muted">Aucune archive disponible.</p>
                            </t>
                        </div>
                    </div>
                    <!-- Galerie de captures (haut droite) -->
                    <div t-if="has_shots" class="col-lg-7">
                        <div id="oskiGallery" class="carousel slide oski-gallery"
                             data-bs-ride="false" data-bs-interval="false">
                            <!-- Compteur de position (remplace carousel-indicators :
                                 Bootstrap plantait sur _setActiveIndicatorElement). -->
                            <span t-if="len(screenshots) &gt; 1" class="oski-gallery-counter">
                                <span class="oski-cur">1</span> / <t t-out="len(screenshots)"/>
                            </span>
                            <div class="carousel-inner">
                                <t t-foreach="screenshots" t-as="shot">
                                    <div t-attf-class="carousel-item #{'active' if shot_index == 0 else ''}">
                                        <img t-attf-src="/web/image/#{shot.id}"
                                             t-att-alt="shot.name"
                                             class="d-block w-100 oski-shot"
                                             data-bs-toggle="modal"
                                             t-attf-data-bs-target="#oskiLightbox"
                                             t-attf-data-shot-src="/web/image/#{shot.id}"
                                             loading="lazy"/>
                                    </div>
                                </t>
                            </div>
                            <t t-if="len(screenshots) > 1">
                                <button class="carousel-control-prev" type="button"
                                        data-bs-target="#oskiGallery" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"/>
                                </button>
                                <button class="carousel-control-next" type="button"
                                        data-bs-target="#oskiGallery" data-bs-slide="next">
                                    <span class="carousel-control-next-icon"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </div>
                <!-- Lightbox plein écran (hors colonne : évite tout ancêtre transformé
                     qui piégerait le backdrop position:fixed du modal) -->
                <div t-if="has_shots" class="modal fade oski-lightbox" id="oskiLightbox" tabindex="-1">
                    <div class="modal-dialog modal-fullscreen">
                        <div class="modal-content">
                            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                            <img src="" alt="Capture agrandie" class="oski-lightbox-img"/>
                        </div>
                    </div>
                </div>
                <!-- Description pleine largeur -->
                <div class="oski-desc">
                    <t t-out="module.description_html"/>
                </div>
            </div>
            </div>
        </t>
    </template>
</odoo>
