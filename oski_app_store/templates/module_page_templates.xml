<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="module_page" name="Page module">
        <t t-call="website.layout">
            <div class="oski-store">
            <div class="container my-5">
                <div class="row">
                    <div class="col-md-8">
                        <h1><t t-out="module.name"/></h1>
                        <p class="lead text-muted"><t t-out="module.summary"/></p>
                        <div class="my-4"><t t-out="module.description_html"/></div>
                    </div>
                    <div class="col-md-4">
                        <div class="card oski-sidecard">
                            <div class="card-body">
                                <span t-if="module.is_free" class="badge text-bg-success mb-2">Gratuit</span>
                                <span t-else="" class="badge text-bg-warning mb-2">Premium</span>
                                <p class="mb-1"><strong>Nom technique :</strong> <t t-out="module.technical_name"/></p>
                                <p class="mb-1"><strong>Licence :</strong> <t t-out="module.license"/></p>
                                <p class="mb-3"><strong>Auteur :</strong> <t t-out="module.author"/></p>
                                <div class="oski-pastilles mb-3" aria-label="Compatibilité">
                                    <t t-set="avail" t-value="module.available_versions()"/>
                                    <t t-foreach="pill_versions" t-as="pv">
                                        <span t-attf-class="oski-dot #{'on' if pv in avail else 'off'} #{'sel' if pv == version else ''}" t-out="pv"/>
                                    </t>
                                </div>
                                <t t-set="target" t-value="module.download_target(version)"/>
                                <t t-if="target and target.attachment_id">
                                    <a t-if="module.is_free"
                                       t-attf-href="/apps/download/#{target.id}"
                                       class="btn btn-success w-100">Télécharger (<t t-out="target.odoo_version"/>)</a>
                                    <a t-else=""
                                       t-attf-href="/shop/cart/update?product_id=#{module.product_tmpl_id.product_variant_id.id}"
                                       class="btn btn-warning w-100">Acheter</a>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">Aucune archive disponible.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </t>
    </template>
</odoo>
