<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Fil d'ariane de l'espace client -->
    <template id="portal_my_home_menu_apps" name="Portail : fil d'ariane applications"
              inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'apps'" class="breadcrumb-item active">
                Mes applications
            </li>
        </xpath>
    </template>

    <!-- Carte d'entrée sur /my -->
    <template id="portal_my_home_apps" name="Mes applications" customize_show="True"
              inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/oski_app_store/static/description/icon.png'"/>
                <t t-set="title">Mes applications</t>
                <t t-set="text">Télécharger les modules achetés, toutes versions</t>
                <t t-set="url" t-value="'/my/apps'"/>
                <t t-set="placeholder_count" t-value="'app_count'"/>
            </t>
        </div>
    </template>

    <!-- Page /my/apps -->
    <template id="portal_my_apps" name="Mes applications">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes applications</t>
            </t>

            <p t-if="not modules" class="alert alert-info mt-3" role="alert">
                Aucune application achetée pour l'instant.
                <a href="/apps">Parcourir le catalogue</a>.
            </p>

            <div t-else="" class="o_portal_my_apps mt-3">
                <p class="text-muted">
                    Une commande confirmée donne droit à l'archive du module pour
                    chaque version d'Odoo proposée. Les liens restent valables.
                </p>
                <div class="row g-3">
                    <div t-foreach="modules" t-as="module" class="col-12 col-lg-6">
                        <div class="card h-100">
                            <div class="card-body d-flex gap-3">
                                <img t-if="module.image_1920" class="oski-portal-icon"
                                     t-attf-src="/web/image/oski.module/#{module.id}/image_1920/64x64"
                                     t-att-alt="module.name"/>
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1">
                                        <a t-att-href="module.website_url" t-out="module.name"/>
                                    </h5>
                                    <p class="text-muted small mb-2" t-out="module.summary"/>
                                    <div class="d-flex flex-wrap gap-2">
                                        <t t-foreach="module.sudo().version_line_ids.sorted('odoo_version')"
                                           t-as="line">
                                            <a t-if="line.attachment_id"
                                               t-attf-href="/apps/download/#{line.id}"
                                               class="btn btn-sm btn-outline-primary">
                                                &#x2B07; <t t-out="line.odoo_version"/>
                                                <span class="text-muted"
                                                      t-out="line.module_version"/>
                                            </a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
