<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Support page. The response time is deliberately absent: it isn't
         settled yet, and a promised delay that isn't kept turns into a
         negative review. Add it here the day it is settled. -->
    <template id="support_page" name="Support">
        <t t-call="website.layout">
            <t t-set="additional_title">Support</t>
            <t t-set="website_meta_description">One address for the whole OdooSkills store: apps@odooskills.com. What's covered, what isn't, and what to attach to a report.</t>
            <div class="oski-store">
                <div class="container oski-legal oski-support py-5">
                    <h1 class="oski-legal-title">Support</h1>
                    <p class="oski-faq-lead">One address for the whole store —
                        free modules as well as paid ones, a question before purchase as well
                        as a failure after installation.</p>

                    <p class="oski-support-mail">
                        <a href="mailto:apps@odooskills.com">apps@odooskills.com</a>
                    </p>

                    <h2>What's covered</h2>
                    <ul>
                        <li>The module won't install, or raises an error.</li>
                        <li>A module feature doesn't behave as its listing describes.</li>
                        <li>An incompatibility with a standard Odoo module.</li>
                        <li>A question about a module's scope before buying it.</li>
                        <li>An order, invoice or download problem.</li>
                    </ul>

                    <h2>What's not covered</h2>
                    <ul>
                        <li>Adapting the module to your processes: that is development.
                            The <a href="/apps/demande-developpement">Request a
                            module</a> form opens a quoted request.</li>
                        <li>Administering your server or your database.</li>
                        <li>Configuring Odoo itself, outside the module concerned.</li>
                        <li>A modified module: describe the modification, it changes
                            everything.</li>
                    </ul>

                    <h2>What to attach</h2>
                    <p>A complete report is handled once; a partial report costs three
                        back-and-forths.</p>
                    <ol>
                        <li>The <strong>Odoo version</strong> and how it is installed.</li>
                        <li>The module's <strong>technical name</strong> and its version.</li>
                        <li>What you expected, what happened.</li>
                        <li>The <strong>full error message</strong> — the server log says
                            more than a screenshot.</li>
                        <li>The path followed in the interface to reproduce the problem.</li>
                    </ol>

                    <h2>Response time</h2>
                    <p>Every message gets a response. The guaranteed delay will be announced
                        with the terms of sale, before sales open.</p>

                    <p class="oski-legal-contact">
                        See also <a href="/apps/faq">the frequently asked questions</a> —
                        they already answer the essentials.
                    </p>
                </div>
            </div>
        </t>
    </template>

    <record id="support_page_record" model="website.page">
        <field name="name">Support</field>
        <field name="url">/apps/support</field>
        <field name="view_id" ref="support_page"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>

    <!-- Page not found: the standard one is in English, illustrated with a
         generic image, and only links back to the homepage. -->
    <template id="store_404" inherit_id="http_routing.404" name="Store — page not found">
        <xpath expr="//div[@id='wrap']/div[hasclass('oe_structure')]" position="replace">
            <div class="oski-store">
                <div class="container oski-404 py-5">
                    <p class="oski-404-code" aria-hidden="true">404</p>
                    <h1 class="oski-404-title">This page does not exist.</h1>
                    <p class="oski-404-lead">The link may be old, or the module may have moved.
                        The catalog, though, hasn't moved.</p>
                    <div class="oski-404-actions">
                        <a href="/apps" class="btn oski-btn-primary">Browse the catalog</a>
                        <a href="/apps/faq" class="oski-404-link">Frequently asked questions</a>
                        <a href="/apps/support" class="oski-404-link">Support</a>
                    </div>
                    <form method="get" action="/apps" class="oski-search oski-404-search">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control"
                                   placeholder="Search for a module…"/>
                            <button type="submit" class="btn oski-btn-primary">Search</button>
                        </div>
                    </form>
                    <p class="oski-404-foot">If the link came from us, let us know at
                        <a href="mailto:apps@odooskills.com">apps@odooskills.com</a>.</p>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
