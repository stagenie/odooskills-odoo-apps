<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Icône commune : image si présente, sinon monogramme (1ère lettre). -->
    <template id="module_icon" name="Icône module">
        <t t-if="module.image_1920">
            <img t-attf-src="/web/image/oski.module/#{module.id}/image_1920"
                 t-att-alt="module.name" class="oski-icon"/>
        </t>
        <t t-else="">
            <span class="oski-monogram" t-out="module.name[0:1].upper()"/>
        </t>
    </template>

    <!-- Carte grille polie. -->
    <template id="module_card" name="Carte module (grille)">
        <t t-set="avail" t-value="module.available_versions()"/>
        <div t-attf-class="card oski-card h-100 #{'is-incompatible' if version not in avail else ''}">
            <div class="card-body d-flex flex-column">
                <div class="oski-card-head mb-2">
                    <t t-call="oski_app_store.module_icon"/>
                </div>
                <h5 class="card-title mb-1">
                    <a t-att-href="module.website_url"><t t-out="module.name"/></a>
                </h5>
                <p class="card-text text-muted oski-clamp-2"><t t-out="module.summary"/></p>
                <div class="mb-2">
                    <span t-if="module.is_free" class="badge text-bg-success">Gratuit</span>
                    <span t-else="" class="badge text-bg-warning">Premium</span>
                </div>
                <div class="oski-pastilles mb-2" aria-label="Compatibilité">
                    <t t-foreach="version_pills" t-as="pv">
                        <span t-attf-class="oski-dot #{'on' if pv['label'] in avail else 'off'}" t-out="pv['label']"/>
                    </t>
                </div>
                <div class="oski-chips mb-2" t-if="module.tag_ids">
                    <t t-foreach="module.tag_ids" t-as="tag">
                        <a t-attf-href="/apps?tag=#{tag.id}" class="oski-chip"><t t-out="tag.name"/></a>
                    </t>
                </div>
                <a t-att-href="module.website_url" class="oski-card-cta mt-auto">Voir →</a>
            </div>
        </div>
    </template>

    <!-- Ligne liste compacte. -->
    <template id="module_row" name="Ligne module (liste)">
        <t t-set="avail" t-value="module.available_versions()"/>
        <div t-attf-class="oski-row #{'is-incompatible' if version not in avail else ''}">
            <div class="oski-row-icon">
                <t t-call="oski_app_store.module_icon"/>
            </div>
            <div class="oski-row-main">
                <a t-att-href="module.website_url" class="oski-row-name"><t t-out="module.name"/></a>
                <p class="oski-row-summary text-muted"><t t-out="module.summary"/></p>
                <div class="oski-chips" t-if="module.tag_ids">
                    <t t-foreach="module.tag_ids" t-as="tag">
                        <a t-attf-href="/apps?tag=#{tag.id}" class="oski-chip"><t t-out="tag.name"/></a>
                    </t>
                </div>
            </div>
            <div class="oski-row-meta">
                <span t-if="module.is_free" class="badge text-bg-success">Gratuit</span>
                <span t-else="" class="badge text-bg-warning">Premium</span>
                <div class="oski-pastilles mt-2" aria-label="Compatibilité">
                    <t t-foreach="version_pills" t-as="pv">
                        <span t-attf-class="oski-dot #{'on' if pv['label'] in avail else 'off'}" t-out="pv['label']"/>
                    </t>
                </div>
            </div>
        </div>
    </template>

    <template id="catalog_page" name="Catalogue des modules">
        <t t-call="website.layout">
            <div class="oski-store">
                <div class="container my-5">
                    <div class="oski-hero">
                        <h1 class="mb-2">OdooSkills Apps</h1>
                        <p>Modules Odoo <t t-out="version"/> prêts à l'emploi — gratuits et premium, signés OdooSkills.</p>
                        <div class="oski-version-pills" role="navigation" aria-label="Version Odoo">
                            <t t-foreach="version_pills" t-as="vp">
                                <a t-att-href="vp['href']"
                                   t-attf-class="oski-pill #{'is-active' if vp['selected'] else ''}">
                                    <t t-out="vp['label']"/>
                                </a>
                            </t>
                        </div>
                    </div>
                    <form method="get" action="/apps" class="oski-search mb-4">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control"
                                   placeholder="Rechercher un module…" t-att-value="search"/>
                            <button type="submit" class="btn">Rechercher</button>
                        </div>
                    </form>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="oski-facets">
                                <div class="oski-facet-group">
                                    <h6>Tri</h6>
                                    <t t-foreach="sort_options" t-as="so">
                                        <a t-att-href="so['href']"
                                           t-attf-class="oski-sort-link #{'is-selected' if so['selected'] else ''}">
                                            <t t-out="so['label']"/>
                                        </a>
                                    </t>
                                </div>
                                <div class="oski-facet-group">
                                    <h6>Prix</h6>
                                    <t t-foreach="pricing_options" t-as="po">
                                        <a t-att-href="po['href']"
                                           t-attf-class="oski-facet #{'is-selected' if po['selected'] else ''}">
                                            <t t-out="po['label']"/>
                                        </a>
                                    </t>
                                </div>
                                <div class="oski-facet-group">
                                    <h6>Catégories</h6>
                                    <t t-foreach="category_options" t-as="co">
                                        <a t-att-href="co['href']"
                                           t-attf-class="oski-facet #{'is-selected' if co['selected'] else ''}">
                                            <t t-out="co['name']"/>
                                        </a>
                                    </t>
                                </div>
                                <div class="oski-facet-group" t-if="tag_options">
                                    <h6>Tags</h6>
                                    <t t-foreach="tag_options" t-as="to">
                                        <a t-att-href="to['href']"
                                           t-attf-class="oski-facet oski-facet-tag #{'is-selected' if to['selected'] else ''}">
                                            <t t-out="to['name']"/>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="oski-results-bar d-flex justify-content-between align-items-center mb-3">
                                <t t-if="has_filters">
                                    <div class="oski-active-filters">
                                        <span>Filtres actifs</span>
                                        <a t-att-href="clear_url" class="oski-clear">Effacer</a>
                                    </div>
                                </t>
                                <t t-else=""><span/></t>
                            </div>
                            <div class="row">
                                <t t-foreach="modules" t-as="module">
                                    <div class="col-md-4 mb-4">
                                        <t t-call="oski_app_store.module_card"/>
                                    </div>
                                </t>
                                <t t-if="not modules">
                                    <p class="text-muted">Aucun module ne correspond à ces filtres.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
