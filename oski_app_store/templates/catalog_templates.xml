<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Icône commune : image si présente, sinon monogramme (1ère lettre). -->
    <template id="module_icon" name="Icône module">
        <t t-if="module.image_1920">
            <img t-attf-src="/web/image/oski.module/#{module.id}/image_1920"
                 t-att-alt="module.name" class="oski-icon" loading="lazy"/>
        </t>
        <t t-else="">
            <span class="oski-monogram" t-out="module.name[0:1].upper()"/>
        </t>
    </template>

    <!-- Carte compacte de la grille. -->
    <template id="module_card" name="Carte module (grille)">
        <t t-set="avail" t-value="module.available_versions()"/>
        <a t-att-href="module.website_url" class="oski-card h-100">
            <div class="oski-card-top">
                <t t-call="oski_app_store.module_icon"/>
                <span t-if="module.is_free" class="oski-badge oski-badge-free">Gratuit</span>
                <span t-else="" class="oski-badge oski-badge-premium">Premium</span>
            </div>
            <h2 class="oski-card-title" t-out="module.name"/>
            <p class="oski-card-summary" t-out="module.summary"/>
            <div class="oski-card-foot">
                <div class="oski-card-versions" aria-label="Compatibilité">
                    <t t-foreach="version_pills" t-as="pv">
                        <span t-attf-class="oski-dot #{'on' if pv['label'] in avail else 'off'}"
                              t-out="pv['label'].split('.')[0]"/>
                    </t>
                </div>
                <span class="oski-card-go" aria-hidden="true">Voir →</span>
            </div>
        </a>
    </template>

    <!-- Dropdown de filtre (groupe d'options pré-calculées). -->
    <template id="filter_dropdown" name="Dropdown filtre">
        <div class="dropdown oski-filter">
            <button class="btn oski-filter-btn dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <t t-out="filter_label"/>
            </button>
            <ul class="dropdown-menu">
                <t t-foreach="filter_options" t-as="fo">
                    <li>
                        <a t-att-href="fo['href']"
                           t-attf-class="dropdown-item #{'active' if fo['selected'] else ''}">
                            <t t-out="fo.get('label') or fo.get('name')"/>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </template>

    <template id="catalog_page" name="Catalogue des modules">
        <t t-call="website.layout">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&amp;display=swap"/>
            <div class="oski-store">
                <!-- Hero pleine largeur : thèse + recherche + spectre de versions.
                     Balise <header> conservée : oski_dev_request y injecte un CTA via xpath. -->
                <header class="oski-hero">
                    <div class="oski-hero-glow" aria-hidden="true"/>
                    <div class="container oski-hero-inner">
                        <span class="oski-eyebrow">Marketplace OdooSkills</span>
                        <h1 class="oski-hero-title">Donnez à Odoo<br/>
                            <em>ce qui lui manque.</em></h1>
                        <p class="oski-hero-lead">Une collection de modules signés OdooSkills —
                            compatibles de la <t t-out="version_spectrum[0]['label']"/> à la
                            <t t-out="version_spectrum[-1]['label']"/>, du gratuit au premium,
                            prêts à installer.</p>
                        <form method="get" action="/apps" class="oski-search">
                            <div class="input-group">
                                <input type="text" name="search" class="form-control"
                                       placeholder="Rechercher un module, une fonctionnalité…"
                                       t-att-value="search"/>
                                <button type="submit" class="btn oski-btn-primary">Rechercher</button>
                            </div>
                        </form>
                        <div class="oski-spectrum" aria-label="Versions Odoo compatibles">
                            <span class="oski-spectrum-label">Compatibilité</span>
                            <div class="oski-spectrum-scale">
                                <t t-foreach="version_spectrum" t-as="sv">
                                    <a t-att-href="sv['href']"
                                       t-attf-class="oski-spectrum-node #{'is-active' if sv['selected'] else ''}">
                                        <span t-out="sv['label'].split('.')[0]"/>
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="container oski-catalog py-5">
                    <div class="oski-toolbar d-flex flex-wrap align-items-center gap-2 mb-4">
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Catégorie</t>
                            <t t-set="filter_options" t-value="category_options"/>
                        </t>
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Version</t>
                            <t t-set="filter_options" t-value="version_pills"/>
                        </t>
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Prix</t>
                            <t t-set="filter_options" t-value="pricing_options"/>
                        </t>
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Tri</t>
                            <t t-set="filter_options" t-value="sort_options"/>
                        </t>
                        <div t-if="tag_options" class="oski-tag-chips d-flex flex-wrap gap-1">
                            <t t-foreach="tag_options" t-as="to">
                                <a t-att-href="to['href']"
                                   t-attf-class="oski-chip #{'is-selected' if to['selected'] else ''}">
                                    <t t-out="to['name']"/>
                                </a>
                            </t>
                        </div>
                        <a t-if="has_filters" t-att-href="clear_url"
                           class="oski-clear ms-auto">Tout effacer</a>
                    </div>

                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
                        <t t-foreach="modules" t-as="module">
                            <div class="col">
                                <t t-call="oski_app_store.module_card"/>
                            </div>
                        </t>
                    </div>
                    <p t-if="not modules and has_filters" class="oski-empty text-center py-5">
                        Aucun module ne correspond à ces filtres.
                        <a t-att-href="clear_url" class="oski-clear">Réinitialiser</a>
                    </p>
                    <div t-if="not modules and not has_filters" class="oski-launch text-center">
                        <div class="oski-spectrum-scale oski-launch-scale" aria-hidden="true">
                            <t t-foreach="version_spectrum" t-as="sv">
                                <span t-attf-class="oski-spectrum-node #{'is-active' if sv['selected'] else ''}"
                                      t-out="sv['label'].split('.')[0]"/>
                            </t>
                        </div>
                        <h2 class="oski-launch-title">Le catalogue ouvre bientôt.</h2>
                        <p class="oski-launch-lead">Les modules sont en cours de finalisation.
                            Revenez très vite, ou écrivez-nous pour un accès anticipé.</p>
                        <a href="/contactus" class="btn oski-btn-primary">Nous contacter</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
