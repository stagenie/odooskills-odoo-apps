<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="catalog_page" name="Catalogue des modules">
        <t t-call="website.layout">
            <div class="oski-store">
                <div class="container my-5">
                    <div class="oski-hero">
                        <h1 class="mb-2">OdooSkills Apps</h1>
                        <p>Modules Odoo <t t-out="version"/> prêts à l'emploi — gratuits et premium, signés OdooSkills.</p>
                        <div class="oski-version-pills" role="navigation" aria-label="Version Odoo">
                            <t t-foreach="version_pills" t-as="vp">
                                <a t-att-href="vp['href']"
                                   t-attf-class="oski-pill #{'is-active' if vp['selected'] else ''}">
                                    <t t-out="vp['label']"/>
                                </a>
                            </t>
                        </div>
                    </div>
                    <form method="get" action="/apps" class="oski-search mb-4">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control"
                                   placeholder="Rechercher un module…" t-att-value="search"/>
                            <button type="submit" class="btn">Rechercher</button>
                        </div>
                    </form>
                    <t t-if="has_filters">
                        <div class="oski-active-filters mb-3">
                            <span>Filtres actifs</span>
                            <a t-att-href="clear_url" class="oski-clear">Effacer</a>
                        </div>
                    </t>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="oski-facets">
                                <div class="oski-facet-group">
                                    <h6>Tri</h6>
                                    <t t-foreach="sort_options" t-as="so">
                                        <a t-att-href="so['href']"
                                           t-attf-class="oski-sort-link #{'is-selected' if so['selected'] else ''}">
                                            <t t-out="so['label']"/>
                                        </a>
                                    </t>
                                </div>
                                <div class="oski-facet-group">
                                    <h6>Prix</h6>
                                    <t t-foreach="pricing_options" t-as="po">
                                        <a t-att-href="po['href']"
                                           t-attf-class="oski-facet #{'is-selected' if po['selected'] else ''}">
                                            <t t-out="po['label']"/>
                                        </a>
                                    </t>
                                </div>
                                <div class="oski-facet-group">
                                    <h6>Catégories</h6>
                                    <t t-foreach="category_options" t-as="co">
                                        <a t-att-href="co['href']"
                                           t-attf-class="oski-facet #{'is-selected' if co['selected'] else ''}">
                                            <t t-out="co['name']"/>
                                        </a>
                                    </t>
                                </div>
                                <div class="oski-facet-group" t-if="tag_options">
                                    <h6>Tags</h6>
                                    <t t-foreach="tag_options" t-as="to">
                                        <a t-att-href="to['href']"
                                           t-attf-class="oski-facet oski-facet-tag #{'is-selected' if to['selected'] else ''}">
                                            <t t-out="to['name']"/>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="row">
                                <t t-foreach="modules" t-as="module">
                                    <div class="col-md-4 mb-4">
                                        <t t-set="avail" t-value="module.available_versions()"/>
                                        <div t-attf-class="card oski-card h-100 #{'is-incompatible' if version not in avail else ''}">
                                            <div class="card-body">
                                                <h5 class="card-title">
                                                    <a t-att-href="module.website_url"><t t-out="module.name"/></a>
                                                </h5>
                                                <p class="card-text text-muted"><t t-out="module.summary"/></p>
                                                <span t-if="module.is_free" class="badge text-bg-success">Gratuit</span>
                                                <span t-else="" class="badge text-bg-warning">Premium</span>
                                                <div class="oski-pastilles mt-2" aria-label="Compatibilité">
                                                    <t t-foreach="version_pills" t-as="pv">
                                                        <span t-attf-class="oski-dot #{'on' if pv['label'] in avail else 'off'}" t-out="pv['label']"/>
                                                    </t>
                                                </div>
                                                <div class="oski-chips mt-2" t-if="module.tag_ids">
                                                    <t t-foreach="module.tag_ids" t-as="tag">
                                                        <a t-attf-href="/apps?tag=#{tag.id}" class="oski-chip"><t t-out="tag.name"/></a>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="not modules">
                                    <p class="text-muted">Aucun module ne correspond à ces filtres.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
