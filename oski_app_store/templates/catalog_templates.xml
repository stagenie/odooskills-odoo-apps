<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Icône commune : image si présente, sinon monogramme (1ère lettre). -->
    <template id="module_icon" name="Icône module">
        <t t-if="module.image_1920">
            <img t-attf-src="/web/image/oski.module/#{module.id}/image_1920"
                 t-att-alt="module.name" class="oski-icon" loading="lazy"/>
        </t>
        <t t-else="">
            <span class="oski-monogram" t-out="module.name[0:1].upper()"/>
        </t>
    </template>

    <!-- Carte compacte de la grille. -->
    <template id="module_card" name="Carte module (grille)">
        <t t-set="avail" t-value="module.available_versions()"/>
        <a t-att-href="module.website_url" class="oski-card h-100">
            <div class="oski-card-top">
                <t t-call="oski_app_store.module_icon"/>
                <span t-if="module.is_free" class="oski-badge oski-badge-free">Free</span>
                <span t-else="" class="oski-badge oski-badge-premium">Premium</span>
            </div>
            <h2 class="oski-card-title" t-out="module.name"/>
            <p class="oski-card-summary" t-out="module.summary"/>
            <div class="oski-card-foot">
                <div class="oski-card-versions" aria-label="Compatibility">
                    <t t-foreach="card_versions" t-as="pv">
                        <span t-attf-class="oski-dot #{'on' if pv in avail else 'off'}"
                              t-out="pv.split('.')[0]"/>
                    </t>
                </div>
                <span t-if="module.counters_visible('download')" class="oski-count"
                      title="Downloads">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12"/><path d="M6 12l6 6 6-6"/><path d="M4 20h16"/></svg>
                    <t t-out="module.download_count"/>
                </span>
                <span class="oski-card-go" aria-hidden="true">View →</span>
            </div>
        </a>
    </template>

    <!-- Dropdown de filtre (groupe d'options pré-calculées). -->
    <template id="filter_dropdown" name="Dropdown filtre">
        <div class="dropdown oski-filter">
            <button class="btn oski-filter-btn dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <t t-out="filter_label"/>
            </button>
            <ul class="dropdown-menu">
                <t t-foreach="filter_options" t-as="fo">
                    <li>
                        <a t-att-href="fo['href']"
                           t-attf-class="dropdown-item #{'active' if fo['selected'] else ''}">
                            <t t-out="fo.get('label') or fo.get('name')"/>
                            <span t-if="fo.get('note')" class="oski-opt-note"
                                  t-out="fo['note']"/>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </template>

    <template id="catalog_page" name="Catalogue des modules">
        <t t-call="website.layout">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&amp;display=swap"/>
            <div class="oski-store">
                <!-- Hero pleine largeur : thèse + recherche + spectre de versions. Une seule action ici : chercher. -->
                <header class="oski-hero">
                    <div class="oski-hero-glow" aria-hidden="true"/>
                    <div class="container oski-hero-inner">
                        <span class="oski-eyebrow">OdooSkills marketplace</span>
                        <h1 class="oski-hero-title">Give Odoo<br/><em>what it's missing.</em></h1>
                        <p class="oski-hero-lead">A collection of modules by OdooSkills — compatible from <t t-out="released_versions[-1]"/> to <t t-out="released_versions[0]"/>, free to premium, ready to install.</p>
                        <form method="get" action="/apps" class="oski-search">
                            <div class="input-group">
                                <input type="text" name="search" class="form-control"
                                       placeholder="Search a module, a feature…"
                                       t-att-value="search"/>
                                <button type="submit" class="btn oski-btn-primary">Search</button>
                            </div>
                        </form>
                        <div class="oski-spectrum" aria-label="Compatible Odoo versions">
                            <span class="oski-spectrum-label">Compatibility</span>
                            <div class="oski-spectrum-scale">
                                <t t-foreach="version_spectrum" t-as="sv">
                                    <a t-att-href="sv['href']"
                                       t-att-title="sv['title']"
                                       t-attf-class="oski-spectrum-node #{'is-active' if sv['selected'] else ''} #{'is-soon' if sv['soon'] else ''}">
                                        <span t-out="sv['label'].split('.')[0]"/>
                                    </a>
                                </t>
                            </div>
                        </div>
                        <p t-if="upcoming_versions" class="oski-hero-soon">
                            <span class="oski-soon-flag">Odoo <t t-out="upcoming_versions[0].split('.')[0]"/></span>
                            is at the door: <t t-out="upcoming_versions[0]"/> archives will follow the official release.
                        </p>
                    </div>
                </header>

                <div class="container oski-catalog py-5">
                    <div class="oski-toolbar d-flex flex-wrap align-items-center gap-2 mb-4">
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Category</t>
                            <t t-set="filter_options" t-value="category_options"/>
                        </t>
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Version</t>
                            <t t-set="filter_options" t-value="version_pills"/>
                        </t>
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Price</t>
                            <t t-set="filter_options" t-value="pricing_options"/>
                        </t>
                        <t t-call="oski_app_store.filter_dropdown">
                            <t t-set="filter_label">Sort</t>
                            <t t-set="filter_options" t-value="sort_options"/>
                        </t>
                        <div t-if="tag_options" class="oski-tag-chips d-flex flex-wrap gap-1">
                            <t t-foreach="tag_options" t-as="to">
                                <a t-att-href="to['href']"
                                   t-attf-class="oski-chip #{'is-selected' if to['selected'] else ''}">
                                    <t t-out="to['name']"/>
                                </a>
                            </t>
                        </div>
                        <a t-if="has_filters" t-att-href="clear_url"
                           class="oski-clear ms-auto">Clear all</a>
                    </div>

                    <div t-if="version_is_upcoming" class="oski-notice" role="status">
                        <strong>Odoo <t t-out="version.split('.')[0]"/> is not released yet.</strong>
                        No <t t-out="version"/> archive is published today&#160;; the modules below ship in their latest available version.
                    </div>

                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
                        <t t-foreach="modules" t-as="module">
                            <div class="col">
                                <t t-call="oski_app_store.module_card"/>
                            </div>
                        </t>
                    </div>
                    <div t-if="not modules and has_filters" class="oski-empty-state text-center">
                        <span class="oski-empty-icon" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/><path d="M8 11h6"/></svg>
                        </span>
                        <h2 class="oski-empty-title" t-out="empty_title"/>
                        <p class="oski-empty-lead">What you are looking for may not exist yet.</p>
                        <div class="oski-empty-actions">
                            <a t-att-href="clear_url" class="oski-empty-reset">Reset filters</a>
                        </div>
                    </div>
                    <div t-if="not modules and not has_filters" class="oski-launch text-center">
                        <div class="oski-spectrum-scale oski-launch-scale" aria-hidden="true">
                            <t t-foreach="version_spectrum" t-as="sv">
                                <span t-attf-class="oski-spectrum-node #{'is-active' if sv['selected'] else ''} #{'is-soon' if sv['soon'] else ''}"
                                      t-out="sv['label'].split('.')[0]"/>
                            </t>
                        </div>
                        <h2 class="oski-launch-title">The catalog opens soon.</h2>
                        <p class="oski-launch-lead">The modules are being finalized. Come back very soon, or write to us for early access.</p>
                        <a href="/contactus" class="btn oski-btn-primary">Contact us</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
