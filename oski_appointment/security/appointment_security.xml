<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_appointment" model="ir.module.category">
        <field name="name">Appointments</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_appointment_user" model="res.groups">
        <field name="name">Appointments / User</field>
        <field name="category_id" ref="module_category_appointment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_appointment_manager" model="res.groups">
        <field name="name">Appointments / Manager</field>
        <field name="category_id" ref="module_category_appointment"/>
        <field name="implied_ids" eval="[(4, ref('group_appointment_user'))]"/>
        <!-- sans démo, l'administrateur n'aurait ni les types de rendez-vous ni la configuration -->
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="appointment_type_company_rule" model="ir.rule">
        <field name="name">Appointment Type: multi-company</field>
        <field name="model_id" ref="model_appointment_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
