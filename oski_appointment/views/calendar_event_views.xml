<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_event_list" model="ir.ui.view">
        <field name="name">calendar.event.appointment.list</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="user_id"/>
                <field name="appointment_type_id"/>
                <field name="appointment_state"/>
            </list>
        </field>
    </record>

    <record id="view_appointment_event_search" model="ir.ui.view">
        <field name="name">calendar.event.appointment.search</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="appointment_type_id"/>
                <field name="user_id"/>
                <filter name="booked" string="Réservés"
                        domain="[('appointment_state', '=', 'booked')]"/>
                <separator/>
                <filter name="group_type" string="Type"
                        context="{'group_by': 'appointment_type_id'}"/>
                <filter name="group_staff" string="Personnel"
                        context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_appointment_event" model="ir.actions.act_window">
        <field name="name">Rendez-vous</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('appointment_type_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_appointment_event_search"/>
        <field name="context">{'list_view_ref': 'oski_appointment.view_appointment_event_list'}</field>
    </record>
</odoo>
