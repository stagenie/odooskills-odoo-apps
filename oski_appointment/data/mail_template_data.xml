<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_appointment_confirmation" model="mail.template">
        <field name="name">Rendez-vous : confirmation</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="subject">Confirmation de votre rendez-vous : {{ object.name }}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="email_to">{{ (object.appointment_partner_id or object.partner_ids[:1]).email_formatted }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Bonjour,</p>
                <p>Votre rendez-vous <strong t-out="object.name">RDV</strong> est confirmé.</p>
                <ul>
                    <li>Date : <span t-out="format_datetime(object.start, tz=object.appointment_tz or object.appointment_type_id.tz or 'UTC', dt_format='dd/MM/yyyy HH:mm')">date</span>
                        (<span t-out="object.appointment_tz or object.appointment_type_id.tz or 'UTC'">fuseau</span>)</li>
                    <li t-if="object.location">Lieu : <span t-out="object.location">lieu</span></li>
                </ul>
                <p>À bientôt.</p>
            </div>
        </field>
    </record>
</odoo>
