"<div>\n"
"                <p>Hello,</p>\n"
"                <p>Your appointment <strong t-out=\"object.name\">Appointment</strong> is confirmed.</p>\n"
"                <ul>\n"
"                    <li>Date: <span t-out=\"format_datetime(object.start, tz=object.appointment_tz or object.appointment_type_id.resource_calendar_id.tz or 'UTC', dt_format='dd/MM/yyyy HH:mm')\">date</span>\n"
