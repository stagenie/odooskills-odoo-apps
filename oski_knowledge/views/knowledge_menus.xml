<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_knowledge_app" model="ir.actions.client">
        <field name="name">Connaissances</field>
        <field name="tag">oski_knowledge.app</field>
    </record>

    <menuitem id="menu_knowledge_root" name="Connaissances" sequence="45"
              web_icon="oski_knowledge,static/description/icon.png"
              action="action_knowledge_app"
              groups="oski_knowledge.group_knowledge_user"/>
    <menuitem id="menu_article_all" name="Tous les articles"
              parent="menu_knowledge_root" action="action_article_all"
              sequence="20"/>
    <menuitem id="menu_article_trash" name="Corbeille"
              parent="menu_knowledge_root" action="action_article_trash"
              sequence="30"/>
    <menuitem id="menu_knowledge_config" name="Configuration"
              parent="menu_knowledge_root" sequence="90"
              groups="oski_knowledge.group_knowledge_manager"/>
</odoo>
