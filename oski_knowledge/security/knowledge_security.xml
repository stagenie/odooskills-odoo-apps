<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_knowledge" model="ir.module.category">
        <field name="name">Connaissances</field>
        <field name="sequence">45</field>
    </record>

    <record id="privilege_knowledge" model="res.groups.privilege">
        <field name="name">Connaissances</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="module_category_knowledge"/>
    </record>

    <record id="group_knowledge_user" model="res.groups">
        <field name="name">Connaissances / Utilisateur</field>
        <field name="privilege_id" ref="privilege_knowledge"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Consulte, crée et gère ses articles ; voit l'espace de travail partagé.</field>
    </record>

    <record id="group_knowledge_manager" model="res.groups">
        <field name="name">Connaissances / Responsable</field>
        <field name="privilege_id" ref="privilege_knowledge"/>
        <field name="implied_ids" eval="[(4, ref('group_knowledge_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Accès total (y compris articles privés d'autrui) et vidage de la corbeille.</field>
    </record>

    <!-- base.group_user reçoit group_knowledge_user : tout interne a l'app (outil collaboratif, décision §3). -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_knowledge_user'))]"/>
    </record>
</odoo>
