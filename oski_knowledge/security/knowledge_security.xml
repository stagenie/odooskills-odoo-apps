<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_knowledge" model="ir.module.category">
        <field name="name">Knowledge</field>
        <field name="sequence">45</field>
    </record>

    <record id="privilege_knowledge" model="res.groups.privilege">
        <field name="name">Knowledge</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="module_category_knowledge"/>
    </record>

    <record id="group_knowledge_user" model="res.groups">
        <field name="name">Knowledge / User</field>
        <field name="privilege_id" ref="privilege_knowledge"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reads, creates and manages own articles; sees the shared workspace.</field>
    </record>

    <record id="group_knowledge_manager" model="res.groups">
        <field name="name">Knowledge / Manager</field>
        <field name="privilege_id" ref="privilege_knowledge"/>
        <field name="implied_ids" eval="[(4, ref('group_knowledge_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access (including other users' private articles) and trash emptying.</field>
    </record>

    <!-- base.group_user reçoit group_knowledge_user : tout interne a l'app (outil collaboratif, décision §3). -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_knowledge_user'))]"/>
    </record>
</odoo>
