<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dms" model="ir.module.category">
        <field name="name">Documents</field>
        <field name="sequence">55</field>
    </record>

    <record id="privilege_dms" model="res.groups.privilege">
        <field name="name">Documents</field>
        <field name="sequence">55</field>
        <field name="category_id" ref="module_category_dms"/>
    </record>

    <record id="group_dms_user" model="res.groups">
        <field name="name">Documents / Utilisateur</field>
        <field name="privilege_id" ref="privilege_dms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dms_manager" model="res.groups">
        <field name="name">Documents / Responsable</field>
        <field name="privilege_id" ref="privilege_dms"/>
        <field name="implied_ids" eval="[(4, ref('group_dms_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ===== ir.rule — TOUTES scopées groups (anti-leak) ===== -->

    <!-- Document : lecture (membre read_group de l'espace OU propriétaire) -->
    <record id="rule_dms_document_read" model="ir.rule">
        <field name="name">Document GED : lecture par espace</field>
        <field name="model_id" ref="model_oski_dms_document"/>
        <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        <field name="domain_force">['|', ('workspace_id.read_group_ids', 'in', user.all_group_ids.ids), ('owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Document : écriture/création (membre write_group) -->
    <record id="rule_dms_document_write" model="ir.rule">
        <field name="name">Document GED : écriture par espace</field>
        <field name="model_id" ref="model_oski_dms_document"/>
        <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        <field name="domain_force">[('workspace_id.write_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Document : suppression (membre manage_group) -->
    <record id="rule_dms_document_unlink" model="ir.rule">
        <field name="name">Document GED : suppression par espace</field>
        <field name="model_id" ref="model_oski_dms_document"/>
        <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        <field name="domain_force">[('workspace_id.manage_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Workspace : lecture (membre d'un des 3 groupes) -->
    <record id="rule_dms_workspace_read" model="ir.rule">
        <field name="name">Espace GED : lecture par groupe</field>
        <field name="model_id" ref="model_oski_dms_workspace"/>
        <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        <field name="domain_force">['|', '|', ('read_group_ids', 'in', user.all_group_ids.ids), ('write_group_ids', 'in', user.all_group_ids.ids), ('manage_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager : accès total, scopé group_dms_manager (NON global) -->
    <record id="rule_dms_document_manager" model="ir.rule">
        <field name="name">Document GED : accès total responsable</field>
        <field name="model_id" ref="model_oski_dms_document"/>
        <field name="groups" eval="[(4, ref('group_dms_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_dms_workspace_manager" model="ir.rule">
        <field name="name">Espace GED : accès total responsable</field>
        <field name="model_id" ref="model_oski_dms_workspace"/>
        <field name="groups" eval="[(4, ref('group_dms_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
