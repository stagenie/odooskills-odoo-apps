<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- `name` n'est pas traduisible : livré en anglais, renommé à
         l'installation dans la langue de l'administrateur (post_init_hook).
         noupdate : une mise à jour ne renomme pas l'espace d'une base
         existante. -->
    <data noupdate="1">
    <record id="dms_workspace_general" model="oski.dms.workspace">
        <field name="name">General</field>
    </record>
    </data>

    <record id="action_ir_attachment_file_dms" model="ir.actions.server">
        <field name="name">Classify in DMS</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records[:1].action_file_in_dms() if records else False</field>
    </record>
</odoo>
