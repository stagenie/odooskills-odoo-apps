<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_file_wizard_form" model="ir.ui.view">
        <field name="name">oski.dms.file.wizard.form</field>
        <field name="model">oski.dms.file.wizard</field>
        <field name="arch" type="xml">
            <form string="Classer dans la GED">
                <group>
                    <field name="attachment_id" readonly="1"/>
                    <field name="workspace_id"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_file" type="object" string="Classer"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
