<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dms_tag_list" model="ir.ui.view">
        <field name="name">oski.dms.tag.list</field>
        <field name="model">oski.dms.tag</field>
        <field name="arch" type="xml">
            <list string="Étiquettes" editable="bottom">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_dms_tag" model="ir.actions.act_window">
        <field name="name">Étiquettes</field>
        <field name="res_model">oski.dms.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
