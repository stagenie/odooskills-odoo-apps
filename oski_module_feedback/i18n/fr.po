#. module: oski_module_feedback
#: model:mail.template,body_html:oski_module_feedback.mail_template_feedback_ack
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p>\n"
"        Thank you for your request <strong t-out=\"object.name or ''\">FB00001</strong>\n"
"        on <strong t-out=\"object.module_id.name or ''\">Module</strong>:\n"
"        \"<t t-out=\"object.title or ''\">Title</t>\".\n"
"    </p>\n"
"    <p>We read every request ourselves. You will receive an e-mail when its status changes.</p>\n"
"    <p style=\"margin: 24px 0px;\">\n"
"        <a t-att-href=\"object.get_base_url() + object.access_url\" style=\"background-color: #714B67; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 8px; font-weight: bold;\">\n"
"            Follow my request\n"
"        </a>\n"
"    </p>\n"
"    <p>The OdooSkills team</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Bonjour <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p>\n"
"        Merci pour votre demande <strong t-out=\"object.name or ''\">FB00001</strong>\n"
"        sur <strong t-out=\"object.module_id.name or ''\">Module</strong>:\n"
"        \"<t t-out=\"object.title or ''\">Title</t>\".\n"
"    </p>\n"
"    <p>Nous lisons chaque demande nous-mêmes. Vous recevrez un courriel à chaque changement de statut.</p>\n"
"    <p style=\"margin: 24px 0px;\">\n"
"        <a t-att-href=\"object.get_base_url() + object.access_url\" style=\"background-color: #714B67; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 8px; font-weight: bold;\">\n"
"            Suivre ma demande\n"
"        </a>\n"
"    </p>\n"
"    <p>L'équipe OdooSkills</p>\n"
"</div>\n"
"        "

#. module: oski_module_feedback
#: model:mail.template,body_html:oski_module_feedback.mail_template_feedback_new
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>New request <strong t-out=\"object.name or ''\">FB00001</strong>.</p>\n"
"    <ul>\n"
"        <li>Module: <t t-out=\"object.module_id.name or ''\">Module</t> (<t t-out=\"object.module_id.technical_name or ''\">oski_x</t>)</li>\n"
"        <li>Odoo version: <t t-out=\"object.odoo_version_id.name or '—'\">19.0</t></li>\n"
"        <li>Type: <t t-out=\"dict(object.fields_get(['request_type'])['request_type']['selection']).get(object.request_type) or ''\">Bug</t></li>\n"
"        <li>From: <t t-out=\"object.partner_id.name or ''\">Customer</t> &lt;<t t-out=\"object.partner_id.email or ''\">mail</t>&gt;</li>\n"
"        <li>Source: <t t-out=\"dict(object.fields_get(['source'])['source']['selection']).get(object.source) or ''\">Module page</t></li>\n"
"    </ul>\n"
"    <p><strong t-out=\"object.title or ''\">Title</strong></p>\n"
"    <p style=\"white-space: pre-wrap;\" t-out=\"object.description or ''\">Description</p>\n"
"    <t t-if=\"object.steps\">\n"
"        <p><strong>Steps to reproduce</strong></p>\n"
"        <p style=\"white-space: pre-wrap;\" t-out=\"object.steps\">Steps</p>\n"
"    </t>\n"
"    <p>\n"
"        <a t-att-href=\"object.get_base_url() + '/odoo/action-oski_module_feedback.action_oski_module_feedback/%s' % object.id\">Open the request</a>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Nouvelle demande <strong t-out=\"object.name or ''\">FB00001</strong>.</p>\n"
"    <ul>\n"
"        <li>Module : <t t-out=\"object.module_id.name or ''\">Module</t> (<t t-out=\"object.module_id.technical_name or ''\">oski_x</t>)</li>\n"
"        <li>Version d'Odoo : <t t-out=\"object.odoo_version_id.name or '—'\">19.0</t></li>\n"
"        <li>Type : <t t-out=\"dict(object.fields_get(['request_type'])['request_type']['selection']).get(object.request_type) or ''\">Bug</t></li>\n"
"        <li>De : <t t-out=\"object.partner_id.name or ''\">Customer</t> &lt;<t t-out=\"object.partner_id.email or ''\">mail</t>&gt;</li>\n"
"        <li>Origine : <t t-out=\"dict(object.fields_get(['source'])['source']['selection']).get(object.source) or ''\">Module page</t></li>\n"
"    </ul>\n"
"    <p><strong t-out=\"object.title or ''\">Title</strong></p>\n"
"    <p style=\"white-space: pre-wrap;\" t-out=\"object.description or ''\">Description</p>\n"
"    <t t-if=\"object.steps\">\n"
"        <p><strong>Étapes pour reproduire</strong></p>\n"
"        <p style=\"white-space: pre-wrap;\" t-out=\"object.steps\">Steps</p>\n"
"    </t>\n"
"    <p>\n"
"        <a t-att-href=\"object.get_base_url() + '/odoo/action-oski_module_feedback.action_oski_module_feedback/%s' % object.id\">Ouvrir la demande</a>\n"
"    </p>\n"
"</div>\n"
"        "

