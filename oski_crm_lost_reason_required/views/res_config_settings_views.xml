<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_oski_lost" model="ir.ui.view">
        <field name="name">res.config.settings.form.oski.lost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Le bloc « CRM » n'a ni nom ni identifiant dans le cœur, et
                 v19 REFUSE d'hériter par l'attribut `title` : on s'accroche
                 donc au seul réglage identifié du bloc. -->
            <xpath expr="//setting[@id='crm_lead']" position="after">
                <setting id="oski_lost_reason"
                         string="Motif de perte obligatoire"
                         help="Une opportunité ne peut plus être perdue sans dire pourquoi — depuis l'écran comme depuis un import ou une action serveur.">
                    <field name="oski_lost_reason_required"/>
                </setting>
                <setting id="oski_lost_feedback"
                         string="Note de clôture obligatoire"
                         help="Exige en plus quelques mots de contexte : c'est ce que relira celui qui reprendra ce client dans un an.">
                    <field name="oski_lost_feedback_required"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
