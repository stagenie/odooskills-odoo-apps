<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oski_login_log_list" model="ir.ui.view">
        <field name="name">oski.login.log.list</field>
        <field name="model">oski.login.log</field>
        <field name="arch" type="xml">
            <list string="Journal des connexions" create="false" edit="false"
                  decoration-danger="result == 'failure'">
                <field name="create_date"/>
                <field name="login"/>
                <field name="user_id"/>
                <field name="result"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="view_oski_login_log_search" model="ir.ui.view">
        <field name="name">oski.login.log.search</field>
        <field name="model">oski.login.log</field>
        <field name="arch" type="xml">
            <search string="Journal des connexions">
                <field name="login"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <filter name="failures" string="Échecs" domain="[('result', '=', 'failure')]"/>
                <filter name="successes" string="Réussites" domain="[('result', '=', 'success')]"/>
                <group>
                    <filter name="group_login" string="Identifiant" domain="[]" context="{'group_by': 'login'}"/>
                    <filter name="group_ip" string="Adresse IP" domain="[]" context="{'group_by': 'ip_address'}"/>
                    <filter name="group_date" string="Date" domain="[]" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oski_login_log" model="ir.actions.act_window">
        <field name="name">Journal des connexions</field>
        <field name="res_model">oski.login.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_oski_login_log"
              name="Journal des connexions"
              parent="base.menu_custom"
              action="action_oski_login_log"
              sequence="59"/>
</odoo>
