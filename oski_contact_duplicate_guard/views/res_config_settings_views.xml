<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_oski_dup" model="ir.ui.view">
        <field name="name">res.config.settings.form.oski.dup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="after">
                <block title="Anti-doublon Contacts" name="oski_dup_container">
                    <setting string="Doublons d'email"
                             help="Avertit si un contact a le même email qu'un autre.">
                        <field name="oski_dup_check_email"/>
                    </setting>
                    <setting string="Doublons de téléphone"
                             help="Avertit si un contact a le même téléphone qu'un autre.">
                        <field name="oski_dup_check_phone"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
