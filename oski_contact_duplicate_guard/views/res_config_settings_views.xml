<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_oski_dup" model="ir.ui.view">
        <field name="name">res.config.settings.form.oski.dup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="after">
                <block title="Contact Duplicate Guard" name="oski_dup_container">
                    <setting string="Email Duplicates"
                             help="Warns when a contact has the same email as another one.">
                        <field name="oski_dup_check_email"/>
                    </setting>
                    <setting string="Phone Duplicates"
                             help="Warns when a contact has the same phone as another one.">
                        <field name="oski_dup_check_phone"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
