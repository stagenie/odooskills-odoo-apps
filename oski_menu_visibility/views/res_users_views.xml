<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_oski_hidden_menus" model="ir.ui.view">
        <field name="name">res.users.form.oski.hidden.menus</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Une vue héritée ne peut pas porter ses groupes sur l'enregistrement en
                     v19 : la restriction se déclare sur l'élément lui-même. -->
                <page string="Hidden Menus" name="oski_hidden_menus" groups="base.group_system">
                    <field name="oski_hidden_menu_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <p class="text-muted">
                        These menus disappear from this user's screen, and from theirs only. Hiding a menu also hides everything it contains. This setting tidies the screen; it does not replace access rights.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
