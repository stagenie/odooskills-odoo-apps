<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="oski_invoice_comment_template_view_list" model="ir.ui.view">
        <field name="name">oski.invoice.comment.template.list</field>
        <field name="model">oski.invoice.comment.template</field>
        <field name="arch" type="xml">
            <list string="Note Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="move_types"/>
            </list>
        </field>
    </record>

    <record id="oski_invoice_comment_template_view_form" model="ir.ui.view">
        <field name="name">oski.invoice.comment.template.form</field>
        <field name="model">oski.invoice.comment.template</field>
        <field name="arch" type="xml">
            <form string="Note Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Legal Notices"/>
                        </h1>
                    </div>
                    <group>
                        <field name="move_types"/>
                        <field name="sequence"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <separator string="Note"/>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oski_invoice_comment_template_view_search" model="ir.ui.view">
        <field name="name">oski.invoice.comment.template.search</field>
        <field name="model">oski.invoice.comment.template</field>
        <field name="arch" type="xml">
            <search string="Note Templates">
                <field name="name"/>
                <filter name="filter_active" string="Active Templates" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_move_types" string="Invoice Type" domain="[]" context="{'group_by': 'move_types'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="oski_invoice_comment_template_action" model="ir.actions.act_window">
        <field name="name">Note Templates</field>
        <field name="res_model">oski.invoice.comment.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="oski_invoice_comment_template_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a reusable note template
            </p>
            <p>
                Note templates let you quickly insert recurring text into an invoice note, which is printed on the PDF.
            </p>
        </field>
    </record>

    <menuitem id="oski_invoice_comment_template_menu"
              name="Note Templates"
              parent="account.menu_finance_configuration"
              action="oski_invoice_comment_template_action"
              sequence="90"/>

</odoo>
