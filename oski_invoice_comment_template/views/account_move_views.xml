<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_oski_comment_template" model="ir.ui.view">
        <field name="name">account.move.form.oski.comment.template</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- On ancre après le champ « payment_reference » de l'en-tête de
                 facture (core account.view_move_form l.810). -->
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="oski_comment_template_id"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]}"
                       options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
