<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_partner_balance" model="ir.actions.report">
        <field name="name">Partner Balance</field>
        <field name="model">oski.partner.balance.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oski_partner_balance.report_partner_balance</field>
        <field name="print_report_name">'Partner Balance'</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_partner_balance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Partner Balance</h2>
                        <p>
                            From <span t-out="wizard.date_from"/>
                            to <span t-out="wizard.date_to"/> —
                            <span t-field="wizard.scope"/> —
                            <span t-field="wizard.target_moves"/>
                            — opening balance:
                            <t t-if="wizard.include_opening">Included</t>
                            <t t-else="">Excluded</t>
                            <t t-if="wizard.journal_filter != 'all'">
                                — journals:
                                <span t-out="', '.join(wizard.journal_ids.mapped('name'))"/>
                                (<span t-out="wizard.journal_filter"/>)
                            </t>
                        </p>
                        <t t-set="section_labels"
                           t-value="{'receivable': 'Customer', 'payable': 'Vendor', 'net': 'Net'}"/>
                        <t t-set="partners" t-value="wizard.line_ids.mapped('partner_id')"/>
                        <t t-foreach="partners" t-as="partner">
                            <t t-set="partner_lines"
                               t-value="wizard.line_ids.filtered(lambda l: l.partner_id == partner)"/>
                            <h4 t-out="partner.display_name"/>
                            <t t-set="sections"
                               t-value="[s for s in ('receivable', 'payable', 'net')
                                         if s in partner_lines.mapped('section')]"/>
                            <t t-foreach="sections" t-as="section">
                                <t t-set="section_lines"
                                   t-value="partner_lines.filtered(lambda l: l.section == section)"/>
                                <h5 t-if="len(sections) > 1"
                                    t-out="section_labels.get(section, section)"/>
                                <table class="table table-sm o_main_table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Journal</th>
                                            <th>Document</th>
                                            <th>Label</th>
                                            <th>Due Date</th>
                                            <th class="text-end">Debit</th>
                                            <th class="text-end">Credit</th>
                                            <th class="text-end">Running Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="section_lines" t-as="line">
                                            <td><span t-out="line.date"/></td>
                                            <td><span t-out="line.journal_id.code"/></td>
                                            <td><span t-out="line.name"/></td>
                                            <td><span t-out="line.label"/></td>
                                            <td><span t-out="line.date_maturity"/></td>
                                            <td class="text-end">
                                                <span t-out="line.debit"
                                                      t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="line.credit"
                                                      t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="line.cumulative"
                                                      t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="7" class="text-end">
                                                <strong>Closing balance</strong>
                                            </td>
                                            <td class="text-end">
                                                <strong><span t-out="section_lines[-1].cumulative"
                                                        t-options='{"widget": "monetary", "display_currency": section_lines[-1].currency_id}'/></strong>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
