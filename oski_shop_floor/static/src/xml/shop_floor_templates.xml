<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="oski_shop_floor.App">
        <div class="o_shop_floor">
            <ScreenWorkcenter t-if="this.state.screen === 'workcenter'"
                              workcenters="this.state.workcenters"
                              onOpen.bind="this.openWorkcenter"/>
            <ScreenOrders t-if="this.state.screen === 'orders'"
                          orders="this.state.orders"
                          onBack.bind="this.goHome"
                          onOpen.bind="this.openOrder"/>
            <ScreenDetail t-if="this.state.screen === 'detail'"
                          detail="this.state.detail"
                          orderId="this.state.orderId"
                          onBack.bind="this.goOrders"/>
        </div>
    </t>

    <t t-name="oski_shop_floor.ScreenWorkcenter">
        <div class="o_sf_screen o_sf_workcenter">
            <h1 class="o_sf_title">Postes de charge</h1>
            <div class="o_sf_grid">
                <button class="o_sf_card" t-foreach="this.props.workcenters" t-as="wc" t-key="wc.id"
                        t-on-click="() => this.props.onOpen(wc.id)">
                    <span class="o_sf_card_name" t-out="wc.name"/>
                    <span class="o_sf_badges">
                        <span class="o_sf_badge o_sf_progress" t-if="wc.count_progress">
                            <t t-out="wc.count_progress"/> en cours
                        </span>
                        <span class="o_sf_badge o_sf_ready">
                            <t t-out="wc.count_ready"/> à faire
                        </span>
                    </span>
                </button>
            </div>
        </div>
    </t>

    <t t-name="oski_shop_floor.ScreenOrders">
        <div class="o_sf_screen o_sf_orders">
            <div class="o_sf_header">
                <button class="o_sf_back" t-on-click="() => this.props.onBack()">← Postes</button>
                <h1 class="o_sf_title">Ordres de travail</h1>
            </div>
            <div class="o_sf_list">
                <button class="o_sf_row" t-foreach="this.props.orders" t-as="o" t-key="o.id"
                        t-att-class="{ 'o_sf_row_active': o.state === 'progress' }"
                        t-on-click="() => this.props.onOpen(o.id)">
                    <span class="o_sf_row_main">
                        <span class="o_sf_row_name" t-out="o.name"/>
                        <span class="o_sf_row_sub" t-out="o.product_name"/>
                    </span>
                    <span class="o_sf_row_state" t-out="o.state === 'progress' ? 'En cours' : 'À faire'"/>
                </button>
                <div class="o_sf_empty" t-if="!this.props.orders.length">Aucun ordre de travail sur ce poste.</div>
            </div>
        </div>
    </t>

    <t t-name="oski_shop_floor.ScreenDetail">
        <div class="o_sf_screen o_sf_detail">
            <div class="o_sf_header">
                <button class="o_sf_back" t-on-click="() => this.props.onBack()">← Ordres</button>
                <h1 class="o_sf_title" t-out="this.wo.name"/>
            </div>

            <div class="o_sf_meta">
                <span t-out="this.wo.product_name"/> · <span t-out="this.wo.production_name"/>
                <span class="o_sf_state" t-out="this.stateLabel"/>
            </div>

            <div class="o_sf_actions">
                <button class="o_sf_btn o_sf_start" t-if="!this.wo.is_user_working and this.wo.state !== 'done' and this.wo.state !== 'cancel'"
                        t-on-click="() => this.start()">Démarrer</button>
                <button class="o_sf_btn o_sf_pause" t-if="this.wo.state === 'progress' and this.wo.is_user_working"
                        t-on-click="() => this.pause()">Pause</button>
                <button class="o_sf_btn o_sf_finish" t-if="this.wo.state === 'progress'"
                        t-on-click="() => this.finish()">Terminer</button>
            </div>

            <div class="o_sf_qty">
                <label>Quantité produite</label>
                <input type="number" step="1" min="0" t-att-value="this.wo.qty_producing"
                       t-on-change="(ev) => this.setQty(ev)"/>
                <span class="o_sf_qty_target">/ <t t-out="this.wo.qty_production"/></span>
            </div>

            <div class="o_sf_scanbox">
                <input type="text" class="o_sf_scan_input" placeholder="Scanner ou saisir un code-barres"
                       t-on-change="(ev) => { this.onScan(ev.target.value); ev.target.value=''; }"/>
            </div>

            <div class="o_sf_components">
                <h2>Composants</h2>
                <div class="o_sf_comp_row" t-foreach="this.wo.components" t-as="comp" t-key="comp.move_id">
                    <span class="o_sf_comp_name" t-out="comp.product_name"/>
                    <span class="o_sf_comp_qty"><t t-out="comp.qty_done"/> / <t t-out="comp.qty_demand"/></span>
                    <button class="o_sf_comp_add" t-on-click="() => this.incComponent(comp)">+1</button>
                </div>
            </div>
        </div>
    </t>

</templates>
