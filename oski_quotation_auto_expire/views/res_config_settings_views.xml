<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_oski_expire" model="ir.ui.view">
        <field name="name">res.config.settings.form.oski.expire</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='quotation_validity_days']" position="after">
                <setting id="oski_quotation_expire"
                         string="Quotation Expiry"
                         help="Cancel every night the quotations whose expiration date has passed. The cancelled quotation keeps a record of its expiry.">
                    <field name="oski_quote_expire_active"/>
                </setting>
                <setting id="oski_quotation_reminder"
                         string="Reminder Before Expiry"
                         help="The salesperson gets an activity — never one more email — on quotations nearing their expiration date. Zero: no reminder. The reminder does not depend on expiry.">
                    <div class="content-group">
                        <div class="mt8">
                            <span>Remind</span>
                            <field name="oski_quote_reminder_days"
                                   class="col-1 oe_inline mx-2"/>
                            <span>day(s) before the expiration date</span>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
