<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form -->
    <record id="view_treasury_cash_form" model="ir.ui.view">
        <field name="name">oski.treasury.cash.form</field>
        <field name="model">oski.treasury.cash</field>
        <field name="arch" type="xml">
            <form string="Cash Register">
                <header>
                    <button name="action_open" string="Open" type="object"
                        class="btn-primary"
                        invisible="state == 'open'"/>
                    <button name="action_close_temporary" string="Close" type="object"
                        invisible="state != 'open'"/>
                    <button name="action_lock" string="Lock" type="object"
                        invisible="state == 'locked'"
                        confirm="Are you sure you want to lock this cash register?"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="open,closed,locked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_operations" type="object"
                            class="oe_stat_button" icon="fa-list">
                            <field name="operation_count" widget="statinfo"
                                string="Operations"/>
                        </button>
                        <button name="action_view_closings" type="object"
                            class="oe_stat_button" icon="fa-lock">
                            <field name="closing_count" widget="statinfo"
                                string="Closings"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Cash register name"/></h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="code"/>
                            <field name="journal_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="responsible_id"/>
                            <field name="location"/>
                            <field name="opening_date"/>
                        </group>
                        <group string="Balances">
                            <field name="has_pending_closing" invisible="1"/>
                            <field name="last_closing_balance" widget="monetary"/>
                            <field name="balance_in_motion" widget="monetary"
                                invisible="not has_pending_closing"/>
                            <field name="current_balance" widget="monetary"/>
                            <field name="last_closing_date"/>
                            <field name="max_amount" widget="monetary"/>
                            <field name="days_since_closing"/>
                            <field name="is_closing_late" invisible="not require_closing"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Authorized Users" name="users">
                            <field name="user_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Closing" name="closing_config">
                            <group>
                                <field name="require_closing"/>
                                <field name="auto_close_days"
                                    invisible="not require_closing"/>
                            </group>
                        </page>
                        <page string="Transfer Control" name="transfer_control">
                            <group>
                                <field name="allow_negative_balance"/>
                                <field name="min_balance" widget="monetary"/>
                                <field name="control_level"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_treasury_cash_list" model="ir.ui.view">
        <field name="name">oski.treasury.cash.list</field>
        <field name="model">oski.treasury.cash</field>
        <field name="arch" type="xml">
            <list string="Cash Registers" decoration-danger="is_closing_late">
                <field name="code"/>
                <field name="name"/>
                <field name="current_balance" widget="monetary"/>
                <field name="balance_in_motion" widget="monetary" optional="hide"/>
                <field name="last_closing_date"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'open'"
                    decoration-warning="state == 'closed'"
                    decoration-danger="state == 'locked'"/>
                <field name="is_closing_late" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_treasury_cash_kanban" model="ir.ui.view">
        <field name="name">oski.treasury.cash.kanban</field>
        <field name="model">oski.treasury.cash</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="current_balance"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="color"/>
                <field name="responsible_id"/>
                <field name="has_pending_closing"/>
                <field name="balance_in_motion"/>
                <field name="days_since_closing"/>
                <field name="location"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>
                                <i class="fa fa-money me-1 text-success" title="Cash register"/>
                                <span t-out="record.code.value"/> -
                                <span t-out="record.name.value"/>
                            </strong>
                            <field name="state" widget="label_selection"
                                options="{'classes': {'open': 'success', 'closed': 'warning', 'locked': 'danger'}}"/>
                        </div>
                        <div class="mt-2 fs-5 fw-bold">
                            <field name="current_balance" widget="monetary"/>
                        </div>
                        <div t-if="record.responsible_id.value" class="mt-1 small text-muted">
                            <i class="fa fa-user me-1" title="Responsible"/>
                            <t t-out="record.responsible_id.value"/>
                        </div>
                        <div t-if="record.location.value" class="small text-muted">
                            <i class="fa fa-map-marker me-1" title="Location"/>
                            <t t-out="record.location.value"/>
                        </div>
                        <!-- Closing in progress indicator -->
                        <div t-if="record.has_pending_closing.raw_value" class="mt-2">
                            <div class="alert alert-info text-center p-1 mb-1 small" role="status">
                                <i class="fa fa-clock-o me-1"/>
                                Closing in progress
                            </div>
                            <div class="small text-warning text-center">
                                <i class="fa fa-arrows-h me-1" title="Balance in motion"/>
                                In motion: <field name="balance_in_motion" widget="monetary"/>
                            </div>
                        </div>
                        <hr class="my-1"/>
                        <div class="d-flex justify-content-between small">
                            <a name="action_open_last_closing" type="object" class="text-primary"
                                title="Open last closing">
                                <i class="fa fa-folder-open me-1"/>Last closing
                            </a>
                            <a name="action_print_last_closing" type="object" class="text-success"
                                title="Print closing report">
                                <i class="fa fa-print me-1"/>Report
                            </a>
                            <a name="action_view_operations" type="object" class="text-muted"
                                title="View all operations">
                                <i class="fa fa-list me-1"/>Operations
                            </a>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="view_treasury_cash_search" model="ir.ui.view">
        <field name="name">oski.treasury.cash.search</field>
        <field name="model">oski.treasury.cash</field>
        <field name="arch" type="xml">
            <search string="Cash Registers">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="responsible_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closing_late" string="Closing Overdue" domain="[('is_closing_late', '=', True)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_treasury_cash" model="ir.actions.act_window">
        <field name="name">Cash Registers</field>
        <field name="res_model">oski.treasury.cash</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="search_view_id" ref="view_treasury_cash_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cash register
            </p>
        </field>
    </record>

    <!-- Operations menu -->
    <menuitem id="menu_treasury_cash"
        name="Cash Registers"
        parent="menu_treasury_operations"
        action="action_treasury_cash"
        sequence="10"/>

    <!-- Direct shortcut: Treasury > Cash Registers (click = kanban) -->
    <menuitem id="menu_treasury_cash_shortcut"
        name="Cash Registers"
        parent="menu_treasury_root"
        action="action_treasury_cash"
        sequence="2"/>
</odoo>
