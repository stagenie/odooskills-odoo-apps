<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Cash operation sequence -->
    <record id="seq_treasury_cash_operation" model="ir.sequence">
        <field name="name">Cash Operation</field>
        <field name="code">oski.treasury.cash.operation</field>
        <field name="prefix">OPC/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <!-- Cash closing sequence -->
    <record id="seq_treasury_cash_closing" model="ir.sequence">
        <field name="name">Cash Closing</field>
        <field name="code">oski.treasury.cash.closing</field>
        <field name="prefix">CLT/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <!-- Safe operation sequence (used by Task 3, kept here as it is harmless
         before the safe model is installed) -->
    <record id="seq_treasury_safe_operation" model="ir.sequence">
        <field name="name">Safe Operation</field>
        <field name="code">oski.treasury.safe.operation</field>
        <field name="prefix">OPS/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <!-- Transfer sequence (used by Task 5) -->
    <record id="seq_treasury_transfer" model="ir.sequence">
        <field name="name">Treasury Transfer</field>
        <field name="code">oski.treasury.transfer</field>
        <field name="prefix">TR/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
