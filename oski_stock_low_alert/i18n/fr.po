#: model:ir.model.fields,help:oski_stock_low_alert.field_product_product__oski_alert_threshold model:ir.model.fields,help:oski_stock_low_alert.field_product_template__oski_alert_threshold
msgid "Below this available quantity, the product is flagged as low on stock. Leave at 0 to disable the alert."
