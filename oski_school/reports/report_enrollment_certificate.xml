<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_enrollment_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mt-4">Enrollment certificate</h2>
                        <p class="mt-4">
                            <span t-field="doc.company_id.name"/> certifies that
                            <strong t-field="doc.student_id.name"/>
                            (registration number <span t-field="doc.student_id.registration_number"/><t t-if="doc.student_id.birth_date">, born on <span t-field="doc.student_id.birth_date"/></t>)
                            is enrolled in <strong t-field="doc.class_id.name"/>,
                            level <span t-field="doc.level_id.name"/> of the program <span t-field="doc.program_id.name"/>,
                            for the period <span t-field="doc.period_id.name"/>
                            (<span t-field="doc.period_id.date_start"/> – <span t-field="doc.period_id.date_end"/>).
                        </p>
                        <p>Status: <span t-field="doc.state"/>.</p>
                        <p class="mt-5">Issued on <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>.</p>
                        <div class="row mt-5">
                            <div class="col-6 offset-6 text-center">
                                <p>The Director</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
