<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_period_form" model="ir.ui.view">
        <field name="name">oski.school.period.form</field>
        <field name="model">oski.school.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_promotion_wizard" type="object" string="Run promotion"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'open'" confirm="Close this period? Active enrollments become completed."/>
                    <button name="action_open_duplicate_wizard" type="object" string="Duplicate structure"
                            invisible="state == 'draft'"/>
                    <button name="action_open_term_wizard" type="object" string="Generate terms"
                            invisible="term_ids"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="2026-2027"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="period_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_current"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="main" string="Terms">
                            <field name="term_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_period_list" model="ir.ui.view">
        <field name="name">oski.school.period.list</field>
        <field name="model">oski.school.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_school_period" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">oski.school.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first school year, semester or session.</p>
        </field>
    </record>
</odoo>
