<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oski_row_color_rule_list" model="ir.ui.view">
        <field name="name">oski.row.color.rule.list</field>
        <field name="model">oski.row.color.rule</field>
        <field name="arch" type="xml">
            <list string="Color Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="expression"/>
                <field name="decoration"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_oski_row_color_rule_form" model="ir.ui.view">
        <field name="name">oski.row.color.rule.form</field>
        <field name="model">oski.row.color.rule</field>
        <field name="arch" type="xml">
            <form string="Color Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="expression"
                               placeholder="state == 'done'"/>
                        <field name="decoration"/>
                        <field name="active"/>
                        <field name="view_id" readonly="1"/>
                    </group>
                    <p class="text-muted">
                        The condition is a Python expression evaluated for each row (same rules as Odoo's <code>decoration-*</code> attributes).
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oski_row_color_rule" model="ir.actions.act_window">
        <field name="name">Row Colors</field>
        <field name="res_model">oski.row.color.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oski_row_color_rule"
              name="Row Colors"
              parent="base.menu_custom"
              action="action_oski_row_color_rule"
              sequence="50"/>
</odoo>
