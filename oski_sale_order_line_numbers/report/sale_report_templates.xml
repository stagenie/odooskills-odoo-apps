<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_oski_line_number"
              inherit_id="sale.report_saleorder_document">

        <!-- En-tête : colonne « N° » en tête du tableau. -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_oski_line_number" class="text-right text-nowrap">N°</th>
        </xpath>

        <!-- Ligne produit : affiche le numéro calculé.
             En v15, les lignes section/note portent un colspan="99" couvrant
             toute la largeur : aucune cellule vide n'est nécessaire pour elles. -->
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_oski_line_number" class="text-right text-nowrap">
                <span t-out="line.oski_line_number"/>
            </td>
        </xpath>

    </template>

</odoo>
