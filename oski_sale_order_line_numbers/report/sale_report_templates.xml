<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_oski_line_number"
              inherit_id="sale.report_saleorder_document">

        <!-- En-tête : colonne « N° » en tête du tableau.
             v16 (Bootstrap 5) : classe d'alignement = text-end (cf. core
             addons/sale/report/ir_actions_report_templates.xml l.73-80). -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_oski_line_number" class="text-end text-nowrap">N°</th>
        </xpath>

        <!-- Ligne produit : affiche le numéro calculé.
             En v16, les lignes section/note portent un colspan="99" couvrant
             toute la largeur : aucune cellule vide n'est nécessaire pour elles
             (cf. core l.118 td_section_line / l.125 td_note_line). -->
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_oski_line_number" class="text-end text-nowrap">
                <span t-out="line.oski_line_number"/>
            </td>
        </xpath>

    </template>

</odoo>
