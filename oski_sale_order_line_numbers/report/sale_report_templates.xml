<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_oski_line_number"
              inherit_id="sale.report_saleorder_document">

        <!-- En-tête : colonne « N° » en tête du tableau. -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_oski_line_number" class="text-end text-nowrap">N°</th>
        </xpath>

        <!-- Ligne produit : affiche le numéro calculé.
             En v18, la cellule du nom de produit est nommée « td_name »
             (et non « td_product_name » comme en v19). -->
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_oski_line_number" class="text-end text-nowrap">
                <span t-out="line.oski_line_number"/>
            </td>
        </xpath>

        <!-- Ligne section ou combo : en v18 les deux partagent la cellule
             « td_section_line ». Le combo porte un numéro à l'écran, le PDF
             l'affiche aussi (sinon la numérotation imprimée saute un chiffre). -->
        <xpath expr="//td[@name='td_section_line']" position="before">
            <td name="td_oski_line_number_section" class="text-end text-nowrap">
                <span t-if="line.product_type == 'combo'" t-out="line.oski_line_number"/>
            </td>
        </xpath>

        <!-- Ligne note : cellule vide. En v18 la cellule est « td_note_line ». -->
        <xpath expr="//td[@name='td_note_line']" position="before">
            <td name="td_oski_line_number_note"/>
        </xpath>

    </template>

</odoo>
